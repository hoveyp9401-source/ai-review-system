[Unit]
Description=AI Review System API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<APP_USER>
Group=<APP_USER>
WorkingDirectory=<APP_DIR>
EnvironmentFile=<ENV_FILE>
ExecStart=<APP_DIR>/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port <API_PORT> --workers <API_WORKERS>
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
