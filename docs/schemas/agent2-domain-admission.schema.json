{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent2.local/schemas/agent2-domain-admission.v1.json",
  "title": "Agent2 Domain Admission Envelope",
  "description": "Flat audit/interchange contract for deterministic, segment-scoped semantic admission. It is not a business receipt or Operation Outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "trace",
    "decisions",
    "tickets",
    "review_items",
    "deferred_events",
    "information_pendings",
    "selection_requests"
  ],
  "properties": {
    "contract_version": {"const": "agent2.domain_admission.v1"},
    "trace": {"$ref": "#/$defs/admission_trace"},
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/admission_decision"}
    },
    "tickets": {
      "type": "array",
      "items": {"$ref": "#/$defs/admission_ticket"}
    },
    "review_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/semantic_review_item"}
    },
    "deferred_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/deferred_semantic_event"}
    },
    "information_pendings": {
      "type": "array",
      "items": {"$ref": "#/$defs/information_pending"}
    },
    "selection_requests": {
      "type": "array",
      "items": {"$ref": "#/$defs/trusted_selection_request"}
    }
  },
  "$defs": {
    "uuid_v5": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "action_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "segment_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "identifier_128": {"type": "string", "minLength": 1, "maxLength": 128},
    "identifier_512": {"type": "string", "minLength": 1, "maxLength": 512},
    "timestamp": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "domain": {
      "enum": ["report", "case", "travel", "knowledge", "chat", "runtime"]
    },
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "stable_id", "version"],
      "properties": {
        "object_type": {"$ref": "#/$defs/identifier_128"},
        "stable_id": {"$ref": "#/$defs/identifier_512"},
        "version": {"type": ["integer", "null"], "minimum": 0},
        "label": {"type": "string", "maxLength": 512}
      }
    },
    "nullable_object_ref": {
      "oneOf": [
        {"$ref": "#/$defs/object_ref"},
        {"type": "null"}
      ]
    },
    "admission_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "tenant_id",
        "user_id",
        "conversation_id",
        "source_turn_id",
        "source_message_id",
        "expected_conversation_state_version",
        "proposal_sha256",
        "contract_version",
        "policy_version",
        "trace_status",
        "admission_summary",
        "failure_reason",
        "idempotency_key",
        "created_at"
      ],
      "properties": {
        "trace_id": {"$ref": "#/$defs/uuid_v5"},
        "tenant_id": {"$ref": "#/$defs/tenant_id"},
        "user_id": {"$ref": "#/$defs/user_id"},
        "conversation_id": {"$ref": "#/$defs/conversation_id"},
        "source_turn_id": {"$ref": "#/$defs/source_id"},
        "source_message_id": {"$ref": "#/$defs/source_id"},
        "expected_conversation_state_version": {"type": "integer", "minimum": 0},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "contract_version": {"const": "agent2.domain_admission.v1"},
        "policy_version": {"$ref": "#/$defs/identifier_128"},
        "trace_status": {"enum": ["evaluated", "failed"]},
        "admission_summary": {
          "enum": [
            "admitted",
            "partially_admitted",
            "blocked",
            "no_op",
            "information_required",
            "review_only",
            "deferred_audit_only"
          ]
        },
        "failure_reason": {"type": "string", "maxLength": 2048},
        "idempotency_key": {"$ref": "#/$defs/identifier_512"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "admission_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "trace_id",
        "tenant_id",
        "user_id",
        "conversation_id",
        "source_turn_id",
        "source_message_id",
        "action_id",
        "segment_id",
        "segment_text_sha256",
        "segment_start_offset",
        "segment_end_offset",
        "domain",
        "operation",
        "object_ref",
        "expected_conversation_state_version",
        "verdict",
        "reason_code",
        "evidence_refs",
        "ticket_id",
        "pending_id",
        "idempotency_key",
        "created_at"
      ],
      "properties": {
        "decision_id": {"$ref": "#/$defs/uuid_v5"},
        "trace_id": {"$ref": "#/$defs/uuid_v5"},
        "tenant_id": {"$ref": "#/$defs/tenant_id"},
        "user_id": {"$ref": "#/$defs/user_id"},
        "conversation_id": {"$ref": "#/$defs/conversation_id"},
        "source_turn_id": {"$ref": "#/$defs/source_id"},
        "source_message_id": {"$ref": "#/$defs/source_id"},
        "action_id": {"$ref": "#/$defs/action_id"},
        "segment_id": {"$ref": "#/$defs/segment_id"},
        "segment_text_sha256": {"$ref": "#/$defs/sha256"},
        "segment_start_offset": {"type": "integer", "minimum": 0},
        "segment_end_offset": {"type": "integer", "minimum": 0},
        "domain": {"$ref": "#/$defs/domain"},
        "operation": {"$ref": "#/$defs/identifier_128"},
        "object_ref": {"$ref": "#/$defs/nullable_object_ref"},
        "expected_conversation_state_version": {"type": "integer", "minimum": 0},
        "verdict": {
          "enum": [
            "admitted",
            "blocked",
            "no_op",
            "information_required",
            "review_only",
            "deferred_audit_only"
          ]
        },
        "reason_code": {"$ref": "#/$defs/identifier_128"},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier_512"},
          "uniqueItems": true
        },
        "ticket_id": {
          "oneOf": [{"$ref": "#/$defs/uuid_v5"}, {"type": "null"}]
        },
        "pending_id": {
          "oneOf": [{"$ref": "#/$defs/uuid_v5"}, {"type": "null"}]
        },
        "idempotency_key": {"$ref": "#/$defs/identifier_512"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {"const": "admitted"},
              "operation": {
                "enum": [
                  "query_daily_report",
                  "query_periodic_report",
                  "answer_case_query",
                  "query_case_progress",
                  "query_operation_status",
                  "search_enterprise_knowledge"
                ]
              }
            },
            "required": ["verdict", "operation"]
          },
          "then": {
            "properties": {
              "ticket_id": {"type": "null"},
              "pending_id": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {"const": "admitted"},
              "operation": {
                "not": {
                  "enum": [
                    "query_daily_report",
                    "query_periodic_report",
                    "answer_case_query",
                    "query_case_progress",
                    "query_operation_status",
                    "search_enterprise_knowledge"
                  ]
                }
              }
            },
            "required": ["verdict", "operation"]
          },
          "then": {
            "properties": {
              "object_ref": {"$ref": "#/$defs/object_ref"},
              "ticket_id": {"$ref": "#/$defs/uuid_v5"},
              "pending_id": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"verdict": {"const": "information_required"}}, "required": ["verdict"]},
          "then": {
            "properties": {
              "ticket_id": {"type": "null"},
              "pending_id": {"$ref": "#/$defs/uuid_v5"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "enum": ["blocked", "no_op", "review_only", "deferred_audit_only"]
              }
            },
            "required": ["verdict"]
          },
          "then": {
            "properties": {
              "ticket_id": {"type": "null"},
              "pending_id": {"type": "null"}
            }
          }
        }
      ]
    },
    "admission_ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket_id",
        "trace_id",
        "decision_id",
        "tenant_id",
        "user_id",
        "conversation_id",
        "source_turn_id",
        "source_message_id",
        "action_id",
        "segment_id",
        "segment_text_sha256",
        "segment_start_offset",
        "segment_end_offset",
        "domain",
        "operation",
        "object_ref",
        "expected_conversation_state_version",
        "authority_scope",
        "allowed_changed_fields",
        "fact_claims_sha256",
        "authorized_command_sha256",
        "policy_version",
        "ticket_status",
        "contract_version",
        "issued_at",
        "expires_at",
        "ttl_seconds",
        "executor_revalidation_required",
        "proves_business_write",
        "consumed_receipt_ref",
        "idempotency_key"
      ],
      "properties": {
        "ticket_id": {"$ref": "#/$defs/uuid_v5"},
        "trace_id": {"$ref": "#/$defs/uuid_v5"},
        "decision_id": {"$ref": "#/$defs/uuid_v5"},
        "tenant_id": {"$ref": "#/$defs/tenant_id"},
        "user_id": {"$ref": "#/$defs/user_id"},
        "conversation_id": {"$ref": "#/$defs/conversation_id"},
        "source_turn_id": {"$ref": "#/$defs/source_id"},
        "source_message_id": {"$ref": "#/$defs/source_id"},
        "action_id": {"$ref": "#/$defs/action_id"},
        "segment_id": {"$ref": "#/$defs/segment_id"},
        "segment_text_sha256": {"$ref": "#/$defs/sha256"},
        "segment_start_offset": {"type": "integer", "minimum": 0},
        "segment_end_offset": {"type": "integer", "minimum": 0},
        "domain": {"$ref": "#/$defs/domain"},
        "operation": {"$ref": "#/$defs/identifier_128"},
        "object_ref": {"$ref": "#/$defs/object_ref"},
        "expected_conversation_state_version": {"type": "integer", "minimum": 0},
        "authority_scope": {"type": "object", "maxProperties": 64},
        "allowed_changed_fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier_128"},
          "uniqueItems": true
        },
        "fact_claims_sha256": {"$ref": "#/$defs/sha256"},
        "authorized_command_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"$ref": "#/$defs/identifier_128"},
        "ticket_status": {
          "enum": ["issued", "consumed", "expired", "cancelled", "conflicted", "permission_revoked"]
        },
        "contract_version": {"const": "agent2.domain_admission.v1"},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "executor_revalidation_required": {"const": true},
        "proves_business_write": {"const": false},
        "consumed_receipt_ref": {
          "oneOf": [{"$ref": "#/$defs/identifier_512"}, {"type": "null"}]
        },
        "idempotency_key": {"$ref": "#/$defs/identifier_512"}
      },
      "allOf": [
        {
          "if": {"properties": {"ticket_status": {"const": "consumed"}}, "required": ["ticket_status"]},
          "then": {"properties": {"consumed_receipt_ref": {"$ref": "#/$defs/identifier_512"}}},
          "else": {"properties": {"consumed_receipt_ref": {"type": "null"}}}
        }
      ]
    },
    "semantic_review_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id", "trace_id", "decision_id", "tenant_id", "user_id",
        "conversation_id", "source_turn_id", "source_message_id", "segment_id",
        "segment_text_sha256", "segment_start_offset", "segment_end_offset",
        "domain", "operation", "object_ref", "reason_code", "review_status",
        "candidate_snapshot", "resolution", "audit_only", "business_write_allowed",
        "idempotency_key", "created_at", "resolved_at"
      ],
      "properties": {
        "review_id": {"$ref": "#/$defs/uuid_v5"},
        "trace_id": {"$ref": "#/$defs/uuid_v5"},
        "decision_id": {"oneOf": [{"$ref": "#/$defs/uuid_v5"}, {"type": "null"}]},
        "tenant_id": {"$ref": "#/$defs/tenant_id"},
        "user_id": {"$ref": "#/$defs/user_id"},
        "conversation_id": {"$ref": "#/$defs/conversation_id"},
        "source_turn_id": {"$ref": "#/$defs/source_id"},
        "source_message_id": {"$ref": "#/$defs/source_id"},
        "segment_id": {"$ref": "#/$defs/segment_id"},
        "segment_text_sha256": {"$ref": "#/$defs/sha256"},
        "segment_start_offset": {"type": "integer", "minimum": 0},
        "segment_end_offset": {"type": "integer", "minimum": 0},
        "domain": {"$ref": "#/$defs/domain"},
        "operation": {"$ref": "#/$defs/identifier_128"},
        "object_ref": {"$ref": "#/$defs/nullable_object_ref"},
        "reason_code": {"$ref": "#/$defs/identifier_128"},
        "review_status": {"enum": ["pending_human_review", "resolved", "dismissed", "expired"]},
        "candidate_snapshot": {"type": "object"},
        "resolution": {"type": "object"},
        "audit_only": {"const": true},
        "business_write_allowed": {"const": false},
        "idempotency_key": {"$ref": "#/$defs/identifier_512"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "resolved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "deferred_semantic_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deferred_event_id", "trace_id", "decision_id", "tenant_id", "user_id",
        "conversation_id", "source_turn_id", "source_message_id", "segment_id",
        "segment_text_sha256", "segment_start_offset", "segment_end_offset",
        "domain", "operation", "object_ref", "reason_code", "event_status",
        "payload", "not_before", "expires_at", "audit_only", "business_write_allowed",
        "requires_fresh_admission", "idempotency_key", "created_at"
      ],
      "properties": {
        "deferred_event_id": {"$ref": "#/$defs/uuid_v5"},
        "trace_id": {"$ref": "#/$defs/uuid_v5"},
        "decision_id": {"oneOf": [{"$ref": "#/$defs/uuid_v5"}, {"type": "null"}]},
        "tenant_id": {"$ref": "#/$defs/tenant_id"},
        "user_id": {"$ref": "#/$defs/user_id"},
        "conversation_id": {"$ref": "#/$defs/conversation_id"},
        "source_turn_id": {"$ref": "#/$defs/source_id"},
        "source_message_id": {"$ref": "#/$defs/source_id"},
        "segment_id": {"$ref": "#/$defs/segment_id"},
        "segment_text_sha256": {"$ref": "#/$defs/sha256"},
        "segment_start_offset": {"type": "integer", "minimum": 0},
        "segment_end_offset": {"type": "integer", "minimum": 0},
        "domain": {"$ref": "#/$defs/domain"},
        "operation": {"$ref": "#/$defs/identifier_128"},
        "object_ref": {"$ref": "#/$defs/nullable_object_ref"},
        "reason_code": {"$ref": "#/$defs/identifier_128"},
        "event_status": {"enum": ["recorded", "superseded", "reviewed", "cancelled", "expired"]},
        "payload": {"type": "object"},
        "not_before": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "audit_only": {"const": true},
        "business_write_allowed": {"const": false},
        "requires_fresh_admission": {"const": true},
        "idempotency_key": {"$ref": "#/$defs/identifier_512"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "trusted_selection_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "version", "label"],
      "properties": {
        "stable_id": {"$ref": "#/$defs/identifier_512"},
        "version": {"type": "integer", "minimum": 0},
        "label": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "trusted_selection_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_request_id", "trace_id", "decision_id", "tenant_id",
        "user_id", "conversation_id", "source_turn_id", "source_message_id",
        "action_id", "segment_id", "segment_text_sha256",
        "segment_start_offset", "segment_end_offset", "domain", "operation",
        "expected_conversation_state_version", "candidates",
        "acceptable_answer_forms", "continuation_payload", "created_at",
        "expires_at", "ttl_seconds", "business_write_allowed", "idempotency_key"
      ],
      "properties": {
        "selection_request_id": {"$ref": "#/$defs/uuid_v5"},
        "trace_id": {"$ref": "#/$defs/uuid_v5"},
        "decision_id": {"$ref": "#/$defs/uuid_v5"},
        "tenant_id": {"$ref": "#/$defs/tenant_id"},
        "user_id": {"$ref": "#/$defs/user_id"},
        "conversation_id": {"$ref": "#/$defs/conversation_id"},
        "source_turn_id": {"$ref": "#/$defs/source_id"},
        "source_message_id": {"$ref": "#/$defs/source_id"},
        "action_id": {"$ref": "#/$defs/action_id"},
        "segment_id": {"$ref": "#/$defs/segment_id"},
        "segment_text_sha256": {"$ref": "#/$defs/sha256"},
        "segment_start_offset": {"type": "integer", "minimum": 0},
        "segment_end_offset": {"type": "integer", "minimum": 1},
        "domain": {"const": "case"},
        "operation": {"const": "record_case_progress"},
        "expected_conversation_state_version": {"type": "integer", "minimum": 0},
        "candidates": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/trusted_selection_candidate"}
        },
        "acceptable_answer_forms": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {"$ref": "#/$defs/identifier_512"}
        },
        "continuation_payload": {"type": "object", "minProperties": 2},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "business_write_allowed": {"const": false},
        "idempotency_key": {"$ref": "#/$defs/identifier_512"}
      }
    },
    "information_pending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending_id", "pending_type", "trace_id", "decision_id", "tenant_id",
        "user_id", "conversation_id", "source_turn_id", "source_message_id",
        "segment_id", "segment_text_sha256", "segment_start_offset",
        "segment_end_offset", "domain", "operation", "object_ref",
        "expected_conversation_state_version", "missing_fields", "question_snapshot",
        "acceptable_answer_forms", "pending_status", "created_at", "expires_at",
        "ttl_seconds", "consumed_by_trace_id", "business_write_allowed", "idempotency_key"
      ],
      "properties": {
        "pending_id": {"$ref": "#/$defs/uuid_v5"},
        "pending_type": {"const": "information"},
        "trace_id": {"$ref": "#/$defs/uuid_v5"},
        "decision_id": {"$ref": "#/$defs/uuid_v5"},
        "tenant_id": {"$ref": "#/$defs/tenant_id"},
        "user_id": {"$ref": "#/$defs/user_id"},
        "conversation_id": {"$ref": "#/$defs/conversation_id"},
        "source_turn_id": {"$ref": "#/$defs/source_id"},
        "source_message_id": {"$ref": "#/$defs/source_id"},
        "segment_id": {"$ref": "#/$defs/segment_id"},
        "segment_text_sha256": {"$ref": "#/$defs/sha256"},
        "segment_start_offset": {"type": "integer", "minimum": 0},
        "segment_end_offset": {"type": "integer", "minimum": 0},
        "domain": {"$ref": "#/$defs/domain"},
        "operation": {"$ref": "#/$defs/identifier_128"},
        "object_ref": {"$ref": "#/$defs/nullable_object_ref"},
        "expected_conversation_state_version": {"type": "integer", "minimum": 0},
        "missing_fields": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier_128"}
        },
        "question_snapshot": {"type": "object"},
        "acceptable_answer_forms": {"type": "object"},
        "pending_status": {
          "enum": ["active", "awaiting_input", "consumed", "expired", "cancelled", "conflicted", "permission_revoked"]
        },
        "created_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "consumed_by_trace_id": {
          "oneOf": [{"$ref": "#/$defs/uuid_v5"}, {"type": "null"}]
        },
        "business_write_allowed": {"const": false},
        "idempotency_key": {"$ref": "#/$defs/identifier_512"}
      },
      "allOf": [
        {
          "if": {"properties": {"pending_status": {"const": "consumed"}}, "required": ["pending_status"]},
          "then": {"properties": {"consumed_by_trace_id": {"$ref": "#/$defs/uuid_v5"}}},
          "else": {"properties": {"consumed_by_trace_id": {"type": "null"}}}
        }
      ]
    }
  }
}
