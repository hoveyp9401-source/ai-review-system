{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent2-selection-pending.v1",
  "title": "Agent2 Selection Pending",
  "type": "object",
  "additionalProperties": false,
  "required": ["pending_id", "tenant_id", "user_id", "conversation_id", "domain", "operation", "source_turn_id", "candidates", "acceptable_answer_forms", "expected_conversation_state_version", "created_at", "expires_at", "status", "continuation_payload", "consumed_receipt_id", "invalidation_reason"],
  "properties": {
    "pending_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "source_turn_id": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stable_id", "version", "label"],
        "properties": {
          "stable_id": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 0},
          "label": {"type": "string", "minLength": 1}
        }
      }
    },
    "acceptable_answer_forms": {"type": "object", "additionalProperties": {"type": "string"}},
    "expected_conversation_state_version": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "consumed", "expired", "invalidated", "cancelled"]},
    "continuation_payload": {"type": "object"},
    "consumed_receipt_id": {"type": "string"},
    "invalidation_reason": {"type": "string"}
  }
}
