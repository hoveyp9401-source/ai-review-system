+def daily_index_delete_semantic_payload(
+    text: str,
+    resources: dict[str, Any],
+) -> dict[str, Any] | None:
+    """Resolve an explicit section ordinal to one trusted stable item."""
+
+    source = str(text or "").strip().rstrip("。！!")
+    multi_index = _unscoped_multi_index_delete_payload(source, resources)
+    if multi_index is not None:
+        return multi_index
+    malformed_section = _MALFORMED_SECTION_DELETE.fullmatch(source)
+    if malformed_section is not None:
+        label = str(malformed_section.group("label") or "")
+        field = _DAILY_SECTION_LABELS[label]
+        if not _trusted_daily_field_items(resources, field):
+            return _daily_clarification_payload(
+                source,
+                reason="daily_section_already_empty",
+                question=(
+                    f"当前{_canonical_daily_section_label(field)}栏目已经是空的，"
+                    "本次没有修改。"
+                ),
+            )
+        return _daily_clarification_payload(
+            source,
+            reason="daily_section_delete_instruction_malformed",
+            question=(
+                f"我没能确定要删除{_canonical_daily_section_label(field)}中的哪一条；"
+                "本次没有修改，请直接说条目编号。"
+            ),
+        )
+    whole_section = _WHOLE_SECTION_DELETE.fullmatch(source)
+    if whole_section is not None:
+        label = str(whole_section.group("label") or "")
+        field = _DAILY_SECTION_LABELS[label]
+        if not _trusted_daily_field_items(resources, field):
+            return _daily_clarification_payload(
+                source,
+                reason="daily_section_already_empty",
+                question=(
+                    f"当前{_canonical_daily_section_label(field)}栏目已经是空的，"
+                    "本次没有修改。"
+                ),
+            )
+        draft = resources.get("daily_draft")
+        draft = draft if isinstance(draft, dict) else {}
+        report_id = str(draft.get("report_id") or "").strip()
+        version = draft.get("version")
+        if not report_id or not isinstance(version, int) or isinstance(version, bool):
+            return _daily_clarification_payload(
+                source,
+                reason="active_daily_report_not_unique",
+                question="当前没有唯一可修改的日报，本次没有清空栏目。",
+            )
+        entity_id = "daily-clear-section-target"
+        action_id = "daily-clear-section-action"
+        return {
+            "intents": ["daily_modify"],
+            "segments": [
+                {
+                    "segment_id": "daily-clear-section-segment",
+                    "text": source,
+                    "intents": ["daily_modify"],
+                    "entity_ids": [entity_id],
+                    "action_ids": [action_id],
+                    "start_offset": 0,
+                    "end_offset": len(source),
+                }
+            ],
+            "entities": [
+                {
+                    "entity_id": entity_id,
+                    "entity_type": "daily_report",
+                    "value": source,
+                    "confidence": 1.0,
+                    "attributes": {
+                        "report_id": report_id,
+                        "version": version,
+                        "report_date": str(draft.get("report_date") or ""),
+                        "field": field,
+                    },
+                }
+            ],
+            "confidence": 1.0,
+            "required_actions": [
+                {
+                    "action_id": action_id,
+                    "action_type": "clear_daily_section",
+                    "intent": "daily_modify",
+                    "entity_ids": [entity_id],
+                    "parameters": {},
+                }
+            ],
+            "clarification_need": None,
+            "context_update": {
+                "current_goal": "daily_modify",
+                "remember_entity_ids": [entity_id],
+                "remember_turn": True,
+            },
+        }
+    match = _SECTION_INDEX_DELETE.search(source)
+    if match is None:
+        return None
+    label = str(match.group("label") or "")
+    field = _DAILY_SECTION_LABELS[label]
+    ordinal = _chinese_ordinal(str(match.group("ordinal") or ""))
+    if ordinal is None:
+        return None
+    draft = resources.get("daily_draft")
+    draft = draft if isinstance(draft, dict) else {}
+    items = [
+        item
+        for item in (draft.get("items") or [])
+        if isinstance(item, dict) and str(item.get("field") or "") == field
+    ]
+    if ordinal < 1 or ordinal > len(items):
+        return _daily_clarification_payload(
+            source,
+            reason="daily_item_ordinal_out_of_range",
+            question=(
+                f"当前{label}没有第 {ordinal} 条可删除。"
+                "请先查看当前内容，再确认条目编号；本次没有修改。"
+            ),
+        )
+    target = items[ordinal - 1]
+    item_id = str(target.get("item_id") or "").strip()
+    if not item_id:
+        return _daily_clarification_payload(
+            source,
+            reason="daily_item_stable_id_missing",
+            question="这条内容还没有稳定条目编号；本次没有修改，请先查看当前日报。",
+        )
+    entity_id = "daily-index-delete-target"
+    action_id = "daily-index-delete-action"
+    return {
+        "intents": ["daily_modify"],
+        "segments": [
+            {
+                "segment_id": "daily-index-delete-segment",
+                "text": str(text or ""),
+                "intents": ["daily_modify"],
+                "entity_ids": [entity_id],
+                "action_ids": [action_id],
+                "start_offset": 0,
+                "end_offset": len(str(text or "")),
+            }
+        ],
+        "entities": [
+            {
+                "entity_id": entity_id,
+                "entity_type": "daily_item_target",
+                # The user segment itself is the grounded selection expression;
+                # the stable ID comes only from the trusted draft resource.
+                "value": source,
+                "confidence": 1.0,
+                "attributes": {"target_item_ids": [item_id]},
+            }
+        ],
+        "confidence": 1.0,
+        "required_actions": [
+            {
+                "action_id": action_id,
+                "action_type": "delete_daily_item",
+                "intent": "daily_modify",
+                "entity_ids": [entity_id],
+                "parameters": {},
+            }
+        ],
+        "clarification_need": None,
+        "context_update": {
+            "current_goal": "daily_modify",
+            "remember_entity_ids": [entity_id],
+            "remember_turn": True,
+        },
+    }
