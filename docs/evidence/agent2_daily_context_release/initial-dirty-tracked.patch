+def daily_structural_clarification_semantic_payload(
+    text: str,
+    resources: dict[str, Any],
+) -> dict[str, Any] | None:
+    """Clarify explicit structural requests that contain no replacement facts.
+
+    A requested item count is not itself report content, and a request to
+    restore a Daily does not identify a stable historical version.  Both are
+    therefore deterministic zero-write clarifications, independent of model
+    wording.
+    """
+
+    source = str(text or "").strip().rstrip("。.！!")
+    draft = resources.get("daily_draft")
+    draft = draft if isinstance(draft, dict) else {}
+    if not str(draft.get("report_id") or "").strip():
+        return None
+    if _DAILY_BARE_WRITE_CONTROL.fullmatch(source) is not None:
+        return _daily_clarification_payload(
+            source,
+            reason="daily_bare_write_control_ambiguous",
+            question=(
+                "当前日报内容已经实时保存；如果你要正式提交，请回复“确认提交”。"
+                "本次没有把这句话写进日报。"
+            ),
+        )
+    if _DAILY_DANGLING_ORDINALS.fullmatch(source) is not None:
+        return _daily_clarification_payload(
+            source,
+            reason="daily_dangling_ordinal_operation_missing",
+            question=(
+                "我看到了今日工作的条目编号，但还不知道你要删除、修改还是合并。"
+                "请补充具体操作；本次没有修改日报。"
+            ),
+        )
+    ordinal_merge = _daily_ordinal_merge_semantic_payload(source, resources)
+    if ordinal_merge is not None:
+        return ordinal_merge
+    ordinal_markers = list(_ORDINAL_PLAN_MARKER.finditer(source))
+    if (
+        re.match(r"^(?:哎[，,]?\s*)?(?:明日|明天)(?:工作)?计划", source)
+        and len(ordinal_markers) >= 2
+        and "嗯" in source
+        and _DAILY_SPOKEN_TWO_ITEM_PLAN.fullmatch(source) is None
+    ):
+        return _daily_clarification_payload(
+            source,
+            reason="daily_spoken_numbered_items_ambiguous",
+            question=(
+                "我听出了多条明日计划，但其中有口语停顿，无法确认每条的完整原文。"
+                "本次没有修改；请把每条计划分行再发一次。"
+            ),
+        )
+    if _is_daily_ordinal_mutation(source):
+        ordinals = _daily_plan_ordinal_references(source)
+        if _is_daily_plan_ordinal_mutation(source):
+            current_count = len(
+                _trusted_daily_field_items(resources, "tomorrow_plan")
+            )
+        else:
+            current_count = max(
+                len(_trusted_daily_field_items(resources, field))
+                for field in ("today_work", "problems", "tomorrow_plan")
+            )
+        if any(ordinal < 1 or ordinal > current_count for ordinal in ordinals):
+            return _daily_clarification_payload(
+                source,
+                reason="daily_ordinal_target_out_of_range",
+                question=(
+                    f"当前明日计划只有 {current_count} 条，你提到的序号不存在；"
+                    "本次没有修改。请按当前序号重新说明。"
+                ),
+            )
+        if not _is_daily_plan_ordinal_mutation(source):
+            # A valid unlabeled ordinal may still be resolved against trusted
+            # stable item IDs by the normal semantic contract.  Only an
+            # impossible index is deterministically blocked here.
+            return None
+        return _daily_clarification_payload(
+            source,
+            reason="daily_ordinal_mutation_requires_exact_operation",
+            question=(
+                "我知道你要按序号调整明日计划，但这句话同时包含了多种操作，"
+                "不能安全地当成整段替换。本次没有修改；请一次说明一项删除、修改或新增。"
+            ),
+        )
+    item_count = _DAILY_ITEM_COUNT_WITHOUT_CONTENT.fullmatch(source)
+    if item_count is not None:
+        count = str(item_count.group("count") or "").strip()
+        return _daily_clarification_payload(
+            source,
+            reason="daily_replacement_items_missing",
+            question=(
+                f"可以，请把明日计划的 {count} 条具体内容发给我；"
+                "本次还没有修改现有日报。"
+            ),
+        )
+    if _DAILY_RESTORE_WITHOUT_VERSION.fullmatch(source) is not None:
+        return _daily_clarification_payload(
+            source,
+            reason="daily_restore_version_missing",
+            question=(
+                "可以恢复，但需要先确定版本：是恢复到刚才删除前，"
+                "还是其他时间的日报内容？本次还没有修改。"
+            ),
+        )
+    return None
+
