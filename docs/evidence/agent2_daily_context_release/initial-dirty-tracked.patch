+def _should_reassess_missing_named_case_facet(
+    interpretation: SemanticInterpretation,
+    *,
+    turn: CognitiveTurn,
+) -> bool:
+    if interpretation.clarification_need is not None:
+        return False
+    if any(
+        action.action_type
+        in {
+            "record_case_progress",
+            "update_case_progress",
+            "delete_case_progress",
+            "query_case_progress",
+            "link_case_progress",
+            "answer_case_query",
+        }
+        for action in interpretation.required_actions
+    ):
+        return False
+    # The focused retry, not this routing guard, distinguishes a Case-work
+    # assertion from a question, service request, example, or opt-out.  Keeping
+    # those turns in the same semantic pass prevents a brittle local heuristic
+    # from both swallowing uncommon work updates and turning requests such as
+    # "帮我找当地资源" into progress writes.
+    return bool(_authorized_case_reference_matches(turn.text, turn.resources))
+
+
+def _should_reassess_missing_travel_facet(
+    interpretation: SemanticInterpretation,
+    *,
+    turn: CognitiveTurn,
+) -> bool:
+    """Open a focused semantic review, never a keyword-derived mutation."""
+
+    if interpretation.clarification_need is not None:
+        return False
+    if any(
+        action.action_type == "record_travel_event"
+        for action in interpretation.required_actions
+    ):
+        return False
+    if not any(
+        action.action_type == "record_case_progress"
+        for action in interpretation.required_actions
+    ):
+        return False
+    return _extract_explicit_travel_event(turn.text) is not None
+
+
+def _is_grounded_travel_reassessment(
+    interpretation: SemanticInterpretation,
+    *,
+    source_text: str,
+) -> bool:
+    if interpretation.clarification_need is not None:
+        return False
+    actions = tuple(interpretation.required_actions)
+    if len(actions) != 1 or actions[0].action_type != "record_travel_event":
+        return False
+    if len(actions[0].entity_ids) != 1:
+        return False
+    entity = next(
+        (
+            item
+            for item in interpretation.entities
+            if item.entity_id == actions[0].entity_ids[0]
+        ),
+        None,
+    )
+    if entity is None or entity.entity_type != "travel_event":
+        return False
+    if entity.value != source_text:
+        return False
+    attributes = entity.attributes
+    if attributes.get("statement_mode") != "asserted":
+        return False
+    if attributes.get("traveler_scope") != "self":
+        return False
+    destination = str(attributes.get("destination") or "").strip()
+    date_hint = str(attributes.get("date_hint") or "").strip()
+    purpose = str(attributes.get("purpose") or "").strip()
+    if not destination or destination not in source_text or not date_hint or not purpose:
+        return False
+    bound_segments = tuple(
+        segment
+        for segment in interpretation.segments
+        if actions[0].action_id in segment.action_ids
+    )
+    return len(bound_segments) == 1 and bound_segments[0].text == source_text
+
+
+def _closed_form_travel_reassessment(
+    *,
+    turn: CognitiveTurn,
+    state: ConversationState,
+) -> SemanticInterpretation | None:
+    """Build one exact-source Travel proposal for the reviewed closed form."""
+
+    try:
+        candidate = _enforce_explicit_travel_event(
+            _retain_only_supplemental_travel(
+                {},
+                source_text=turn.text,
+            ),
+            text=turn.text,
+        )
+        candidate = _normalize_unique_action_entity_bindings(candidate)
+        interpretation = SemanticInterpretation.from_payload(candidate)
+        validate_semantic_interpretation_contract(interpretation)
+        _validate_turn_contract(turn, state, interpretation)
+        if _is_grounded_travel_reassessment(
+            interpretation,
+            source_text=turn.text,
+        ):
+            return interpretation
+    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
+        pass
+    return None
+
+
+_EXPLICIT_DAILY_ITEM_MUTATION_SOURCE = re.compile(
+    r"^(?:修改|修订|调整|改|把|将).{0,16}"
+    r"(?:今日工作|今天工作|明日计划|明天计划|问题与风险|问题和风险)"
+    r"\s*第?\s*(?:\d+|[一二三四五六七八九十]+)\s*(?:条|项|个|题)"
+)
+_INDEPENDENT_CASE_CLAUSE = re.compile(
+    r"(?:^|[；;。！？!?，,])\s*(?:另外|另有|还有|同时|除此之外)"
+)
+
+
+def _suppress_case_side_effects_for_daily_item_mutation(
+    payload: dict[str, Any],
+    *,
+    source_text: str,
+) -> dict[str, Any]:
+    """Keep an explicit Daily item edit from becoming a Case mutation.
+
+    The replacement text may legitimately contain words such as ``案件`` or
+    ``进展``.  Inside a closed ``修改明日计划第二条……`` operation those words
+    are business text for the selected report item, not independent authority
+    to create CaseProgress.  A separately introduced clause (``另外……``)
+    remains available to the normal multi-intent contract.
+    """
+
+    source = str(source_text or "").strip()
+    match = _EXPLICIT_DAILY_ITEM_MUTATION_SOURCE.match(source)
+    if match is None or _INDEPENDENT_CASE_CLAUSE.search(source[match.end() :]):
+        return payload
+    actions = payload.get("required_actions")
+    entities = payload.get("entities")
+    segments = payload.get("segments")
+    if not all(isinstance(value, list) for value in (actions, entities, segments)):
