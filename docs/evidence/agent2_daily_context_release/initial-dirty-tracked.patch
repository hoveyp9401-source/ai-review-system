+def daily_report_echo_semantic_payload(text: str) -> dict[str, Any] | None:
+    """Treat a pasted assistant Daily snapshot as an echo, never fresh input."""
+
+    source = str(text or "").strip()
+    historical_recap_echo = bool(
+        source.startswith("当前填报日期：")
+        and "目前已收到复盘：" in source
+        and "今日工作完成情况：" in source
+        and "明日计划（明天计划）：" in source
+    )
+    if _DAILY_ECHO.fullmatch(source) is None and not historical_recap_echo:
+        return None
+    payload = _daily_clarification_payload(
+        source,
+        reason="daily_report_echo",
+        question=(
+            "你发来的是一段日报回显，我没有把它重复写入。"
+            "如需调整，请直接说明栏目、条目编号和新内容。"
+        ),
+    )
+    payload["context_update"] = {
+        "preserve_current_goal": True,
+        "remember_turn": False,
+    }
+    return payload
