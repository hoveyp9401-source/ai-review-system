+def _broad_decomposition_preserves_original_actions(
+    interpretation: SemanticInterpretation,
+    *,
+    focused_results: tuple[
+        tuple[StructuredReportItem, SemanticInterpretation], ...
+    ],
+    source_text: str,
+) -> bool:
+    """Require recovery to preserve action multiplicity and source anchors.
+
+    A set-of-types comparison is insufficient: two Case clauses can carry the
+    same action type.  This check counts actions and, when the original entity
+    value or evidence identifies one or more clauses, requires the same action
+    type to be recovered in every anchored clause.  Shared aliases therefore
+    fail closed instead of silently marking a sibling clause as recovered.
+    """
+
+    original_total = Counter(
+        action.action_type for action in interpretation.required_actions
+    )
+    recovered_total = Counter(
+        action.action_type
+        for _, focused in focused_results
+        for action in focused.required_actions
+    )
+    if any(recovered_total[action_type] < count for action_type, count in original_total.items()):
+        return False
+
+    entities_by_id = {
+        entity.entity_id: entity for entity in interpretation.entities
+    }
+    segments_by_action: dict[str, list[Any]] = {}
+    for segment in interpretation.segments:
+        for action_id in segment.action_ids:
+            segments_by_action.setdefault(action_id, []).append(segment)
+
+    required_by_clause: Counter[tuple[int, str]] = Counter()
+    for action in interpretation.required_actions:
+        clause_positions: set[int] = set()
+        for entity_id in action.entity_ids:
+            entity = entities_by_id.get(entity_id)
+            if entity is None:
+                continue
+            value = str(entity.value or "").strip()
+            if len(value) >= 2:
+                clause_positions.update(
+                    position
+                    for position, (item, _) in enumerate(focused_results)
+                    if value in item.value
+                )
+            if clause_positions:
+                continue
+            for segment in segments_by_action.get(action.action_id, ()):
+                source_span = _segment_source_span(
+                    segment,
+                    source_text=source_text,
+                )
+                if source_span is None:
+                    continue
+                segment_start, _ = source_span
+                for raw_span in entity.attributes.get("evidence_spans") or ():
+                    if (
+                        not isinstance(raw_span, (list, tuple))
+                        or len(raw_span) != 2
+                        or not all(isinstance(value, int) for value in raw_span)
+                    ):
+                        continue
+                    evidence_start = segment_start + raw_span[0]
+                    evidence_end = segment_start + raw_span[1]
+                    clause_positions.update(
+                        position
+                        for position, (item, _) in enumerate(focused_results)
+                        if evidence_start < item.end_offset
+                        and evidence_end > item.start_offset
+                    )
+        for position in clause_positions:
+            required_by_clause[(position, action.action_type)] += 1
+
+    recovered_by_clause = Counter(
+        (position, action.action_type)
+        for position, (_, focused) in enumerate(focused_results)
+        for action in focused.required_actions
+    )
+    return all(
+        recovered_by_clause[key] >= count
+        for key, count in required_by_clause.items()
+    )
