+def _travel_semantic_anchors(
+    segment_entities: tuple[ConversationEntity, ...],
+) -> tuple[str, ...]:
+    """Project typed travel meaning into fact-relation anchors.
+
+    Destination and purpose may guide semantic overlap, but they never become
+    object identities or execution authority. Combining them also tolerates a
+    model attaching a case label to the destination while ensuring that a
+    shared city alone cannot unlock travel's lower overlap threshold.
+    """
+
+    anchors: list[str] = []
+    for entity in segment_entities:
+        if entity.entity_type != "travel_event":
+            continue
+        destination = str(entity.attributes.get("destination") or "").strip()
+        purpose = str(entity.attributes.get("purpose") or "").strip()
+        if destination:
+            anchors.append(destination)
