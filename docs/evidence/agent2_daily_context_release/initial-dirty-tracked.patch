+def daily_sequential_ordinal_semantic_payload(
+    text: str,
+    resources: dict[str, Any],
+    *,
+    active_field: str | None,
+) -> dict[str, Any] | None:
+    """Continue one explicitly active Daily list by ordinal.
+
+    The field comes from authoritative conversation state, never from words in
+    the new item.  Therefore ``第三个是未签约施工合同跟进展`` remains the third
+    Daily item even though its literal body contains Case-looking vocabulary.
+    Only the next ordinal may append; repeating the current last ordinal is a
+    restatement of that stable item; gaps fail closed.
+    """
+
+    source = str(text or "").strip().rstrip("。！!")
+    match = _DAILY_SEQUENTIAL_ORDINAL_ITEM.fullmatch(source)
+    if match is None:
+        return None
+    ordinal = _chinese_ordinal(str(match.group("ordinal") or ""))
+    value = str(match.group("value") or "").strip()
+    if ordinal is None or ordinal < 1 or not value:
+        return None
+    if active_field not in {"today_work", "problems", "tomorrow_plan"}:
+        candidate_fields = []
+        for field in ("today_work", "problems", "tomorrow_plan"):
+            count = len(_trusted_daily_field_items(resources, field))
+            if count > 0 and ordinal in {count, count + 1}:
+                candidate_fields.append(field)
+        if len(candidate_fields) != 1:
+            if candidate_fields:
+                return _daily_clarification_payload(
+                    source,
+                    reason="daily_sequential_ordinal_section_ambiguous",
+                    question=(
+                        "这个连续序号可能属于多个日报栏目。请补充“今日工作”、"
+                        "“问题与风险”或“明日计划”；本次没有修改。"
+                    ),
+                )
+            return None
+        active_field = candidate_fields[0]
+    items = _trusted_daily_field_items(resources, active_field)
+    current_count = len(items)
+    section_label = _canonical_daily_section_label(active_field)
+    if ordinal not in {current_count, current_count + 1} or (
+        current_count == 0 and ordinal != 1
+    ):
+        return _daily_clarification_payload(
+            source,
+            reason="daily_sequential_ordinal_out_of_range",
+            question=(
+                f"当前{section_label}有 {current_count} 条，不能直接接第 {ordinal} 条。"
+                "本次没有修改；请按连续序号重新说明。"
+            ),
+        )
+    if ordinal == current_count and current_count > 0:
+        target_id = str(items[ordinal - 1].get("item_id") or "").strip()
+        if not target_id:
+            return _daily_clarification_payload(
+                source,
+                reason="daily_item_stable_id_missing",
+                question="这条内容还没有稳定条目编号；本次没有修改，请先查看当前日报。",
+            )
+        original = str(items[ordinal - 1].get("text") or "").strip()
+        if (
+            "跟进的跟" in value
+            and ("盯人的盯" in value or "目字旁" in value)
+        ):
+            spoken_prefix = value.split("跟跟进的跟", 1)[0].strip(" ，,")
+            if spoken_prefix.endswith("跟钉上传"):
+                proposed = spoken_prefix[: -len("跟钉上传")] + "跟盯上传"
+                return _daily_clarification_payload(
+                    source,
+                    reason="daily_spelling_correction_needs_confirmation",
+                    question=(
+                        f"你是想把第 {ordinal} 条改成“{proposed}”吗？"
+                        "本次还没有修改，请回复“确认”或直接发完整新内容。"
+                    ),
+                )
+            elif original.count("钉钉上传") == 1:
+                proposed = original.replace("钉钉上传", "跟盯上传", 1)
+                return _daily_clarification_payload(
+                    source,
+                    reason="daily_spelling_correction_needs_confirmation",
+                    question=(
+                        f"你是想把第 {ordinal} 条改成“{proposed}”吗？"
+                        "本次还没有修改，请回复“确认”或直接发完整新内容。"
+                    ),
+                )
+            elif original.count("跟钉上传") == 1:
+                proposed = original.replace("跟钉上传", "跟盯上传", 1)
+                return _daily_clarification_payload(
+                    source,
+                    reason="daily_spelling_correction_needs_confirmation",
+                    question=(
+                        f"你是想把第 {ordinal} 条改成“{proposed}”吗？"
+                        "本次还没有修改，请回复“确认”或直接发完整新内容。"
+                    ),
+                )
+        entity_id = "daily-sequential-restatement-target"
+        action_id = "daily-sequential-restatement-action"
+        return {
+            "intents": ["daily_modify"],
+            "segments": [
+                {
+                    "segment_id": "daily-sequential-restatement-segment",
+                    "text": source,
+                    "intents": ["daily_modify"],
+                    "entity_ids": [entity_id],
+                    "action_ids": [action_id],
+                    "start_offset": 0,
+                    "end_offset": len(source),
+                }
+            ],
+            "entities": [
+                {
+                    "entity_id": entity_id,
+                    "entity_type": "daily_item_target",
+                    "value": source,
+                    "confidence": 1.0,
+                    "attributes": {
+                        "target_item_ids": [target_id],
+                        "replacement": value,
+                        "field": active_field,
+                    },
+                }
+            ],
+            "confidence": 1.0,
+            "required_actions": [
+                {
+                    "action_id": action_id,
+                    "action_type": "edit_daily_item",
+                    "intent": "daily_modify",
+                    "entity_ids": [entity_id],
+                    "parameters": {},
+                }
+            ],
+            "clarification_need": None,
+            "context_update": {
+                "current_goal": "daily_append",
+                "remember_entity_ids": [entity_id],
+                "remember_turn": True,
+            },
+        }
+
+    entity_id = "daily-sequential-append-event"
+    action_id = "daily-sequential-append-action"
+    return {
+        "intents": ["daily_append"],
+        "segments": [
+            {
+                "segment_id": "daily-sequential-append-segment",
+                "text": source,
+                "intents": ["daily_append"],
+                "entity_ids": [entity_id],
+                "action_ids": [action_id],
+                "start_offset": 0,
+                "end_offset": len(source),
+            }
+        ],
+        "entities": [
+            {
+                "entity_id": entity_id,
+                "entity_type": "daily_event",
+                "value": value,
+                "confidence": 1.0,
+                "attributes": {"field": active_field},
+            }
+        ],
+        "confidence": 1.0,
+        "required_actions": [
+            {
+                "action_id": action_id,
+                "action_type": "capture_daily_event",
+                "intent": "daily_append",
+                "entity_ids": [entity_id],
+                "parameters": {},
