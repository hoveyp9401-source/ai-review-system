+def _daily_ordinal_merge_semantic_payload(
+    source: str,
+    resources: dict[str, Any],
+) -> dict[str, Any] | None:
+    """Compile section + ordinals + merge into one stable-ID command.
+
+    The grammar is compositional: it identifies the domain section, operation,
+    and ordinal arguments independently.  It therefore covers natural word
+    order and punctuation variants without enumerating complete sentences.
+    """
+
+    compact = re.sub(r"[\s，。；：、,.!?！？:;]+", "", str(source or ""))
+    if "合并" not in compact:
+        return None
+    section_matches = {
+        field
+        for label, field in _DAILY_SECTION_LABELS.items()
+        if label in compact
+    }
+    if len(section_matches) != 1:
+        return None
+    field = next(iter(section_matches))
+    matching_labels = sorted(
+        (
+            label
+            for label, label_field in _DAILY_SECTION_LABELS.items()
+            if label_field == field and label in compact
+        ),
+        key=len,
+        reverse=True,
+    )
+    if not matching_labels:
+        return None
+    ordinal_text = compact.replace(matching_labels[0], "", 1)
+    ordinal_text = ordinal_text.replace("合并", "")
+    ordinal_text = re.sub(r"(?:把|将|第|条|项|个|和|与|及|的|里|中)", "", ordinal_text)
+    if not re.fullmatch(r"[一二三四五六七八九\d]{2,}", ordinal_text):
+        return None
+    ordinals = tuple(
+        ordinal
+        for value in ordinal_text
+        if (ordinal := _chinese_ordinal(value)) is not None
+    )
+    items = _trusted_daily_field_items(resources, field)
+    if (
+        len(ordinals) < 2
+        or len(set(ordinals)) != len(ordinals)
+        or any(ordinal < 1 or ordinal > len(items) for ordinal in ordinals)
+    ):
+        return _daily_clarification_payload(
+            source,
+            reason="daily_ordinal_target_out_of_range",
+            question=(
+                f"当前{_canonical_daily_section_label(field)}只有 {len(items)} 条，"
+                "你提到的序号并不都存在；本次没有修改。请按当前序号重新说明。"
+            ),
+        )
+    target_ids = [
+        str(items[ordinal - 1].get("item_id") or "").strip()
+        for ordinal in ordinals
+    ]
+    if any(not item_id for item_id in target_ids):
+        return _daily_clarification_payload(
+            source,
+            reason="daily_item_stable_id_missing",
+            question="目标内容还没有稳定条目编号；本次没有修改，请先查看当前日报。",
+        )
+    return {
+        "intents": ["daily_modify"],
+        "segments": [
+            {
+                "segment_id": "daily-ordinal-merge-segment",
+                "text": source,
+                "intents": ["daily_modify"],
+                "entity_ids": ["daily-ordinal-merge-target"],
+                "action_ids": ["daily-ordinal-merge-action"],
+                "start_offset": 0,
+                "end_offset": len(source),
+            }
+        ],
+        "entities": [
+            {
+                "entity_id": "daily-ordinal-merge-target",
+                "entity_type": "daily_item_target",
+                "value": source,
+                "confidence": 1.0,
+                "attributes": {
+                    "field": field,
+                    "target_item_ids": target_ids,
+                },
+            }
+        ],
+        "confidence": 1.0,
+        "required_actions": [
+            {
+                "action_id": "daily-ordinal-merge-action",
+                "action_type": "merge_daily_items",
+                "intent": "daily_modify",
+                "entity_ids": ["daily-ordinal-merge-target"],
+                "parameters": {},
+            }
+        ],
+        "clarification_need": None,
+        "context_update": {
+            "current_goal": "daily_modify",
+            "remember_entity_ids": ["daily-ordinal-merge-target"],
+            "remember_turn": True,
+        },
+    }
+
