+def daily_scoped_ordinal_edit_semantic_payload(
+    text: str,
+    resources: dict[str, Any],
+) -> dict[str, Any] | None:
+    """Resolve section, ordinal and replacement as independent semantic slots."""
+
+    source = str(text or "").strip().rstrip("。！？?")
+    match = _DAILY_SCOPED_ORDINAL_EDIT.fullmatch(source)
+    if match is None:
+        return None
+    field = _DAILY_SCOPED_SECTION_ALIASES[str(match.group("section"))]
+    ordinal = _chinese_ordinal(str(match.group("ordinal") or ""))
+    replacement = str(match.group("replacement") or "").strip()
+    items = _trusted_daily_field_items(resources, field)
+    if (
+        ordinal is None
+        or ordinal < 1
+        or ordinal > len(items)
+        or not replacement
+    ):
+        return _daily_clarification_payload(
+            source,
+            reason="daily_ordinal_target_out_of_range",
+            question="没有找到唯一可修改的日报条目，本次没有改动。请按当前栏目和序号重新说明。",
+        )
+    return _daily_item_edit_payload(
+        source,
+        target_id=str(items[ordinal - 1].get("item_id") or ""),
+        replacement=replacement,
+        field=field,
+        segment_id="daily-scoped-ordinal-edit-segment",
+        entity_id="daily-scoped-ordinal-edit-target",
+        action_id="daily-scoped-ordinal-edit-action",
+    )
