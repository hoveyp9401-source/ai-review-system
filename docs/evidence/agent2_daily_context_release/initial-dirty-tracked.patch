+def _is_daily_plan_ordinal_mutation(source: str) -> bool:
+    compact = str(source or "").strip()
+    if re.match(r"^(?:明日|明天)(?:工作)?计划", compact) is None:
+        return False
+    return bool(
+        _DAILY_PLAN_MUTATION_VERB.search(compact)
+        and _DAILY_PLAN_ORDINAL_REFERENCE.search(compact)
+    )
+
+
+def _is_daily_ordinal_mutation(source: str) -> bool:
+    compact = str(source or "").strip()
+    return bool(
+        _DAILY_PLAN_MUTATION_VERB.search(compact)
+        and _DAILY_PLAN_ORDINAL_REFERENCE.search(compact)
+    )
+
+
+def _daily_plan_ordinal_references(source: str) -> tuple[int, ...]:
+    ordinals: list[int] = []
+    for match in _DAILY_PLAN_ORDINAL_REFERENCE.finditer(str(source or "")):
+        ordinal = _chinese_ordinal(str(match.group("ordinal") or ""))
+        if ordinal is not None:
+            ordinals.append(ordinal)
+    return tuple(ordinals)
