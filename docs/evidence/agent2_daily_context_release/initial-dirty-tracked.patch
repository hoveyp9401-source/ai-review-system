+def daily_compound_section_correction_semantic_payload(
+    text: str,
+    resources: dict[str, Any],
+) -> dict[str, Any] | None:
+    """Combine one explicit item correction with one explicit Daily section clause."""
+
+    source = str(text or "")
+    parts = [value.strip() for value in re.split(r"\n\s*\n+", source) if value.strip()]
+    if len(parts) != 2:
+        return None
+    correction = daily_item_section_correction_semantic_payload(parts[0], resources)
+    section = daily_section_cue_semantic_payload(parts[1], resources)
+    if correction is None or section is None:
+        return None
+    correction_entities = list(correction.get("entities") or [])
+    section_entities = list(section.get("entities") or [])
+    correction_actions = list(correction.get("required_actions") or [])
+    section_actions = list(section.get("required_actions") or [])
+    correction_start = source.find(parts[0])
+    section_start = source.find(parts[1], correction_start + len(parts[0]))
+    segments: list[dict[str, Any]] = []
+    for payload, offset in ((correction, correction_start), (section, section_start)):
+        for raw_segment in payload.get("segments") or []:
+            segment = dict(raw_segment)
+            local_start = int(segment.get("start_offset", 0))
+            local_end = int(segment.get("end_offset", len(str(segment.get("text") or ""))))
+            segment["start_offset"] = offset + local_start
+            segment["end_offset"] = offset + local_end
+            segments.append(segment)
+    intents = list(
+        dict.fromkeys(
+            [
+                *list(correction.get("intents") or []),
+                *list(section.get("intents") or []),
+            ]
+        )
+    )
+    remembered_ids = [
+        str(item.get("entity_id") or "")
+        for item in [*correction_entities, *section_entities]
+        if str(item.get("entity_id") or "")
+    ]
+    return {
+        "intents": intents,
+        "segments": segments,
+        "entities": [*correction_entities, *section_entities],
+        "confidence": min(
+            float(correction.get("confidence", 1.0)),
+            float(section.get("confidence", 1.0)),
+        ),
+        "required_actions": [*correction_actions, *section_actions],
+        "clarification_need": (
+            correction.get("clarification_need")
+            or section.get("clarification_need")
+        ),
+        "context_update": {
+            "current_goal": "daily_report",
+            "remember_entity_ids": remembered_ids,
+            "remember_turn": True,
+        },
+    }
