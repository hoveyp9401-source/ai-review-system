+    """Bind an explicit submit only to the trusted current Daily draft."""
+
+    source = str(text or "").strip().rstrip("。！!")
+    if _EXPLICIT_DAILY_SUBMIT.fullmatch(source) is None:
+        return None
+    draft = resources.get("daily_draft")
+    draft = draft if isinstance(draft, dict) else {}
+    status = str(draft.get("status") or "").strip()
+    if status == "completed":
+        return _daily_clarification_payload(
+            source,
+            reason="completed_daily_submit_acknowledged",
+            question="好的，当前日报已经提交，无需重复提交。",
+        )
+    if status != "collecting" or not str(draft.get("report_id") or "").strip():
+        return _daily_clarification_payload(
+            source,
+            reason="active_daily_report_not_unique",
