+def _daily_submission_label(value: object) -> str:
+    if isinstance(value, datetime):
+        resolved = value
+    else:
+        raw = str(value or "").strip()
+        if not raw:
+            return ""
+        try:
+            resolved = datetime.fromisoformat(raw.replace("Z", "+00:00"))
+        except ValueError:
+            return ""
+    if resolved.tzinfo is not None:
+        resolved = resolved.astimezone(ZoneInfo("Asia/Shanghai"))
+    return resolved.strftime("%H:%M")
