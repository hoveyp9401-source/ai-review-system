+def _has_cross_clause_action_segment(
+    interpretation: SemanticInterpretation,
+    *,
+    clauses: tuple[StructuredReportItem, ...],
+) -> bool:
+    """Detect when one proposed action segment swallows sibling clauses.
+
+    Offsets are authoritative when present.  Exact source text containment is
+    used only as a compatibility fallback for older model payloads that omit
+    offsets.  This check says nothing about the clauses' meaning; it only asks
+    whether the first proposal used a boundary broader than one explicit
+    source clause.
+    """
+
+    for segment in interpretation.segments:
+        if not segment.action_ids:
+            continue
+        if segment.start_offset >= 0 and segment.end_offset > segment.start_offset:
+            overlaps = sum(
+                segment.start_offset < clause.end_offset
+                and segment.end_offset > clause.start_offset
+                for clause in clauses
+            )
+        else:
+            segment_text = segment.text.strip()
+            overlaps = sum(
+                clause.value in segment_text
+                for clause in clauses
+            )
+        if overlaps > 1:
+            return True
+    return False
+
+
+def _segment_source_span(
+    segment: Any,
+    *,
+    source_text: str,
+) -> tuple[int, int] | None:
+    start = int(getattr(segment, "start_offset", -1))
+    end = int(getattr(segment, "end_offset", -1))
+    text = str(getattr(segment, "text", "") or "")
+    if (
+        0 <= start < end <= len(source_text)
+        and source_text[start:end] == text
+    ):
+        return start, end
+    if text and source_text.count(text) == 1:
+        start = source_text.index(text)
+        return start, start + len(text)
+    return None
+
