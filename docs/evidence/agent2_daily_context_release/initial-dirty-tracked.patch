+def _uncovered_semantic_clause_items(
+    interpretation: SemanticInterpretation,
+    *,
+    source_text: str,
+) -> tuple[StructuredReportItem, ...]:
+    """Return independently separated clauses with no grounded action.
+
+    This is a coverage audit only.  It neither assigns a domain nor constructs
+    an entity/action.  A second semantic proposal remains responsible for
+    meaning, and Admission remains responsible for write eligibility.
+    """
+
+    clauses = _semantic_clause_items(source_text)
+    if not clauses:
+        return ()
+    entities_by_id = {
+        entity.entity_id: entity for entity in interpretation.entities
+    }
+    segments_by_action: dict[str, list[SemanticSegment]] = {}
+    for segment in interpretation.segments:
+        for action_id in segment.action_ids:
+            segments_by_action.setdefault(action_id, []).append(segment)
+
+    uncovered: list[StructuredReportItem] = []
+    for clause in clauses:
+        covered = False
+        for action in interpretation.required_actions:
+            exact_clause_segment = any(
+                segment.text.strip() == clause.value
+                for segment in segments_by_action.get(action.action_id, ())
+            )
+            if exact_clause_segment:
+                covered = True
+                break
+            for entity_id in action.entity_ids:
+                entity = entities_by_id.get(entity_id)
+                if entity is None:
+                    continue
+                attributes = getattr(entity, "attributes", {}) or {}
+                for segment in segments_by_action.get(action.action_id, ()):
+                    source_span = _segment_source_span(
+                        segment,
+                        source_text=source_text,
+                    )
+                    if source_span is None:
+                        continue
+                    segment_start, _ = source_span
+                    for raw_span in attributes.get("evidence_spans") or ():
+                        if (
+                            not isinstance(raw_span, (list, tuple))
+                            or len(raw_span) != 2
+                        ):
+                            continue
+                        start, end = raw_span
+                        if not isinstance(start, int) or not isinstance(end, int):
+                            continue
+                        if start < 0 or end <= start or end > len(segment.text):
+                            continue
+                        evidence_start = segment_start + start
+                        evidence_end = segment_start + end
+                        if (
+                            evidence_start < clause.end_offset
+                            and evidence_end > clause.start_offset
+                        ):
+                            covered = True
+                            break
+                    if covered:
+                        break
+                if covered:
+                    break
+            if covered:
+                break
+        if not covered:
+            uncovered.append(clause)
+    return tuple(uncovered[:4])
