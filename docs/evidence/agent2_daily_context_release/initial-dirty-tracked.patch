+_DENSE_DAILY_FUTURE_BOUNDARY = re.compile(
+    r"(?:(?:预计|计划|安排)\s*)?"
+    r"(?:明天|明日|明儿|明个|后天|大后天|下周|下星期|下礼拜)"
+)
+
+
+def _daily_future_section_boundary(source_text: str) -> re.Match[str] | None:
+    source = str(source_text or "")
+    for match in _DENSE_DAILY_FUTURE_BOUNDARY.finditer(source):
+        prefix = source[: match.start()].rstrip(" ，,。；;")
+        if re.search(r"(?:如果|若|等到)$", prefix):
+            continue
+        return match
+    return None
+
+
+def _structured_daily_document_misses_explicit_section(
+    document: StructuredDailyDocument,
+    *,
+    source_text: str,
+) -> bool:
+    fields = set(document.fields)
+    return bool(
+        (_dense_daily_temporal_shape(source_text) and "tomorrow_plan" not in fields)
+        or (
+            _dense_daily_has_explicit_problem_section(source_text)
+            and "problems" not in fields
+        )
+    )
+
+
+def _looks_like_current_daily_clause(text: str) -> bool:
+    source = str(text or "").strip()
+    if len(source) < 4:
+        return False
+    if has_current_day_anchor(source):
+        return True
+    return bool(
+        re.search(
+            r"(?:完成|处理|推进|沟通|整理|复核|提交|参加|收集|优化|审核|"
+            r"催收|归档|移交|联系|跟进|出差|请假|开展|协调)",
+            source,
+        )
+    )
+
+
+def _active_daily_contextual_narrative_shape(turn: CognitiveTurn) -> bool:
+    """Recognize a substantial continuation only under one trusted Daily draft."""
+
+    source = str(turn.text or "").strip()
+    current_time_anchor = has_current_day_anchor(source) or bool(
+        re.match(r"^(?:另外|补充)?(?:今天|今日)?(?:上午|下午|晚上|早上|中午|刚刚|刚才)", source)
+    )
+    return bool(
+        _active_daily_document_context(turn.resources)
+        and len(source) >= 60
+        and current_time_anchor
+        and sum(source.count(mark) for mark in "，；。！？\n") >= 3
+    )
+
+
+def _should_reassess_dense_daily_narrative(
+    interpretation: SemanticInterpretation,
+    *,
+    turn: CognitiveTurn,
+) -> bool:
+    temporal_shape = _dense_daily_temporal_shape(turn.text)
+    contextual_shape = _active_daily_contextual_narrative_shape(turn)
+    if interpretation.clarification_need is not None or not (
+        temporal_shape or contextual_shape
+    ):
+        return False
+    actions = tuple(
+        action
+        for action in interpretation.required_actions
+        if action.action_type == "capture_daily_event"
+    )
+    entities_by_id = {
+        entity.entity_id: entity
+        for entity in interpretation.entities
+        if entity.entity_type == "daily_event"
+    }
+    if contextual_shape and not actions:
+        return True
+    captured_fields = {
+        str(entities_by_id[entity_id].attributes.get("field") or "")
+        for action in actions
+        for entity_id in action.entity_ids
+        if entity_id in entities_by_id
+    }
+    if (
+        _dense_daily_has_explicit_problem_section(turn.text)
+        and "problems" not in captured_fields
+    ):
+        return True
+    sentence_units = _dense_daily_sentence_units(turn.text)
+    if (
+        len(actions) > 1
+        and len(sentence_units) > len(actions)
+        and _daily_capture_source_coverage(
+            interpretation,
+            source_text=turn.text,
+        )
+        < 0.60
+    ):
+        return True
+    if len(actions) != 1 or len(actions[0].entity_ids) != 1:
+        return False
+    entity = entities_by_id.get(actions[0].entity_ids[0])
+    return entity is not None and entity.value.strip() == turn.text.strip()
+
+
+def _dense_daily_has_explicit_problem_section(source_text: str) -> bool:
+    return bool(
+        re.search(
+            r"(?:问题[与和/]?风险|风险[与和/]?问题|(?:至于)?(?:一个)?疑难问题)"
+            r"(?:就是|是|叫|[，,:：])",
+            str(source_text or ""),
+        )
+    )
+
+
+def _daily_capture_source_coverage(
+    interpretation: SemanticInterpretation,
+    *,
+    source_text: str,
+) -> float:
+    """Measure how much exact source evidence Daily captures account for.
+
+    This is only a reassessment signal.  It never creates a fact or grants
+    write authority; all focused output still has to pass the closed semantic
+    contract and Domain Admission.
+    """
+
+    source_length = len(str(source_text or ""))
+    if source_length <= 0:
+        return 0.0
+    capture_action_ids = {
+        action.action_id
+        for action in interpretation.required_actions
+        if action.action_type == "capture_daily_event"
+    }
+    ranges = sorted(
+        (
+            max(0, segment.start_offset),
+            min(source_length, segment.end_offset),
+        )
+        for segment in interpretation.segments
+        if capture_action_ids.intersection(segment.action_ids)
+        and 0 <= segment.start_offset < segment.end_offset <= source_length
+    )
+    if not ranges:
+        return 0.0
+    covered = 0
+    current_start, current_end = ranges[0]
+    for start, end in ranges[1:]:
+        if start <= current_end:
+            current_end = max(current_end, end)
+            continue
+        covered += current_end - current_start
+        current_start, current_end = start, end
+    covered += current_end - current_start
+    return covered / source_length
+
+
+def _is_grounded_dense_daily_decomposition(
+    interpretation: SemanticInterpretation,
+    *,
+    source_text: str,
+    require_cross_time: bool = True,
+) -> bool:
+    actions = interpretation.required_actions
+    entities = interpretation.entities
+    segments = interpretation.segments
+    if (
+        interpretation.clarification_need is not None
+        or set(interpretation.intents) != {"daily_append"}
+        or len(actions) < 2
+        or len(actions) != len(entities)
+        or len(actions) != len(segments)
+    ):
+        return False
+    entities_by_id = {entity.entity_id: entity for entity in entities}
+    actions_by_id = {action.action_id: action for action in actions}
+    if len(entities_by_id) != len(entities) or len(actions_by_id) != len(actions):
+        return False
+    consumed_entities: set[str] = set()
+    ranges: list[tuple[int, int]] = []
+    fields: set[str] = set()
+    for segment in segments:
+        if (
+            set(segment.intents) != {"daily_append"}
+            or len(segment.action_ids) != 1
+            or len(segment.entity_ids) != 1
+        ):
+            return False
+        action = actions_by_id.get(segment.action_ids[0])
+        entity = entities_by_id.get(segment.entity_ids[0])
+        if (
+            action is None
+            or entity is None
+            or action.action_type != "capture_daily_event"
+            or action.intent != "daily_append"
+            or tuple(action.entity_ids) != (entity.entity_id,)
+            or entity.entity_type != "daily_event"
+            or entity.entity_id in consumed_entities
+            or entity.value != segment.text
+            or source_text.count(entity.value) != 1
+        ):
+            return False
+        field = str(entity.attributes.get("field") or "")
+        if field not in {"today_work", "problems", "tomorrow_plan"}:
+            return False
+        start = source_text.find(entity.value)
+        end = start + len(entity.value)
+        if start < 0 or not entity.value.strip():
+            return False
+        consumed_entities.add(entity.entity_id)
+        fields.add(field)
+        ranges.append((start, end))
+    if consumed_entities != set(entities_by_id):
+        return False
+    ordered = sorted(ranges)
+    if ranges != ordered or any(
+        left[1] > right[0] for left, right in zip(ordered, ordered[1:])
+    ):
+        return False
+    if require_cross_time:
+        return {"today_work", "tomorrow_plan"}.issubset(fields)
+    if "tomorrow_plan" in fields:
+        return False
+    return "today_work" in fields
+
+
+def _dense_daily_sentence_units(source_text: str) -> tuple[str, ...]:
+    """Split immutable Daily clauses, including explicit future-time boundaries."""
+
+    source = str(source_text or "")
+    units: list[str] = []
+    spoken_ordinals = tuple(
+        re.finditer(
+            r"(?:一个是|第(?:第)?(?:[一二三四五六七八九十]+|\d+)个(?:是)?)",
+            source,
+        )
+    )
+    if len(spoken_ordinals) >= 3:
+        block_starts = [0, *(match.start() for match in spoken_ordinals[1:])]
+        block_ends = [*block_starts[1:], len(source)]
+        for start, end in zip(block_starts, block_ends):
+            block = source[start:end].strip()
+            if not block:
+                continue
+            boundary = _daily_future_section_boundary(block)
+            if boundary is not None and boundary.start() > 0:
+                current = block[: boundary.start()].strip()
+                future = block[boundary.start() :].strip()
+                if current:
+                    units.append(current)
+                units.extend(_punctuated_daily_units(future))
+                continue
+            if boundary is not None:
+                units.extend(_punctuated_daily_units(block))
+                continue
+            units.append(block)
+        return tuple(units) or ((source.strip(),) if source.strip() else ())
+    for match in re.finditer(
+        r"[^。！？!?；;\n]+(?:[。！？!?；;]+|(?=\n|$))",
+        source,
+    ):
+        clause = match.group(0).strip()
+        if not clause:
+            continue
+        boundary = _daily_future_section_boundary(clause)
+        boundary_prefix = clause[: boundary.start()].strip() if boundary is not None else ""
+        if (
+            boundary is not None
+            and boundary.start() > 0
+            and (
+                _looks_like_current_daily_clause(boundary_prefix)
+                or _explicit_problem_status_clause(boundary_prefix)
+            )
+        ):
+            current = clause[: boundary.start()].strip()
+            future = clause[boundary.start() :].strip()
+            if current:
+                units.append(current)
+            if future:
+                units.append(future)
+            continue
+        units.append(clause)
+    return tuple(units) or ((source.strip(),) if source.strip() else ())
+
+
+def _punctuated_daily_units(source_text: str) -> tuple[str, ...]:
+    return tuple(
+        clause
+        for match in re.finditer(
+            r"[^。！？!?；;\n]+(?:[。！？!?；;]+|(?=\n|$))",
+            str(source_text or ""),
+        )
+        if (clause := match.group(0).strip())
+    )
+
+
+def _explicit_problem_status_clause(text: str) -> bool:
+    """Recognize a self-contained risk label before an explicit future plan."""
+
+    return bool(
+        re.fullmatch(
+            r"(?:问题(?:与|及)?风险|风险(?:与|及)?问题)\s*[:：]?\s*"
+            r"(?:暂无|无|没有)\s*[，,；;]?",
+            str(text or "").strip(),
+        )
+    )
+
+
+def _daily_interpretation_from_field_labels(
+    *,
+    turn: CognitiveTurn,
+    state: ConversationState,
+    sentence_units: tuple[str, ...],
+    payload: Mapping[str, Any],
+) -> SemanticInterpretation | None:
+    """Compile model labels into an exact, closed cognition contract."""
+
+    raw_fields = payload.get("fields")
+    if not isinstance(raw_fields, list) or len(raw_fields) != len(sentence_units):
+        return None
+    fields = tuple(str(field or "") for field in raw_fields)
+    if any(field not in {"today_work", "problems", "tomorrow_plan"} for field in fields):
+        return None
+    cross_time = _dense_daily_temporal_shape(turn.text)
+    if cross_time and not {"today_work", "tomorrow_plan"}.issubset(fields):
+        return None
+    if not cross_time and ("today_work" not in fields or "tomorrow_plan" in fields):
+        return None
+    entities: list[dict[str, Any]] = []
+    actions: list[dict[str, Any]] = []
+    segments: list[dict[str, Any]] = []
+    cursor = 0
+    entity_ids: list[str] = []
+    for index, (value, field) in enumerate(zip(sentence_units, fields), start=1):
+        start = turn.text.find(value, cursor)
+        if start < cursor:
+            return None
+        end = start + len(value)
+        cursor = end
+        entity_id = f"dense-daily-labeled-event-{index}"
+        action_id = f"dense-daily-labeled-action-{index}"
+        entity_ids.append(entity_id)
+        entities.append(
+            {
+                "entity_id": entity_id,
+                "entity_type": "daily_event",
+                "value": value,
+                "confidence": 1.0,
+                "attributes": {"field": field},
+            }
+        )
+        actions.append(
+            {
+                "action_id": action_id,
+                "action_type": "capture_daily_event",
+                "intent": "daily_append",
+                "entity_ids": [entity_id],
+                "parameters": {},
+            }
+        )
+        segments.append(
+            {
+                "segment_id": f"dense-daily-labeled-segment-{index}",
+                "text": value,
+                "intents": ["daily_append"],
+                "entity_ids": [entity_id],
+                "action_ids": [action_id],
+                "start_offset": start,
+                "end_offset": end,
+            }
+        )
+    interpretation = SemanticInterpretation.from_payload(
+        {
+            "intents": ["daily_append"],
+            "segments": segments,
+            "entities": entities,
+            "confidence": 1.0,
+            "required_actions": actions,
+            "clarification_need": None,
+            "context_update": {
+                "current_goal": "daily_append",
+                "remember_entity_ids": entity_ids,
+                "remember_turn": True,
+            },
+        }
+    )
+    validate_semantic_interpretation_contract(interpretation)
+    _validate_turn_contract(turn, state, interpretation)
+    return interpretation
+
+
+def _dense_daily_clarification(turn: CognitiveTurn) -> SemanticInterpretation:
+    return SemanticInterpretation.from_payload(
+        {
+            "intents": ["daily_append"],
+            "segments": [],
+            "entities": [],
+            "confidence": 1.0,
