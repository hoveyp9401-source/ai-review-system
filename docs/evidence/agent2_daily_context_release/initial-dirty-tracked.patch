+def _daily_date_label(value: object) -> str:
+    if isinstance(value, datetime):
+        resolved = value.date()
+    elif isinstance(value, date):
+        resolved = value
+    else:
+        try:
+            resolved = date.fromisoformat(str(value or "")[:10])
+        except ValueError:
+            return str(value or "").strip()
+    return f"{resolved.month} 月 {resolved.day} 日"
