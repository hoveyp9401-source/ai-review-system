+def _semantic_clause_items(
+    source_text: str,
+) -> tuple[StructuredReportItem, ...]:
+    """Return a small, source-ordered set of explicitly separated clauses.
+
+    This is intentionally punctuation-driven.  It does not classify a clause,
+    infer a domain, or create a business action.  The size bound prevents a
+    long pasted document from turning one semantic turn into an unbounded set
+    of model calls.
+    """
+
+    clauses: list[StructuredReportItem] = []
+    for match in _SEMANTIC_CLAUSE.finditer(str(source_text or "")):
+        raw = match.group(0)
+        value = raw.strip()
+        if not value:
+            continue
+        leading = len(raw) - len(raw.lstrip())
+        start = match.start() + leading
+        clauses.append(
+            StructuredReportItem(
+                field="",
+                value=value,
+                start_offset=start,
+                end_offset=start + len(value),
+            )
+        )
+    if len(clauses) < 2 or len(clauses) > 6:
+        return ()
+    return tuple(clauses)
+
