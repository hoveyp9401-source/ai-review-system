+def _unscoped_multi_index_delete_payload(
+    source: str,
+    resources: dict[str, Any],
+) -> dict[str, Any] | None:
+    """Resolve ``把5、7去掉`` only when one trusted section can own both.
+
+    Bare ordinals are not allowed to mean "the most recent items".  They are
+    accepted only when the current trusted draft proves that exactly one
+    section contains every requested ordinal; otherwise the operation remains
+    zero-write and asks for the section name.
+    """
+
+    match = re.fullmatch(r"(?:把)?(?P<body>.+?)(?:去掉|删除|删掉)", source)
+    if match is None:
+        return None
+    body = str(match.group("body") or "").strip()
+    if any(label in body for label in _DAILY_SECTION_LABELS):
+        return None
+    token_pattern = re.compile(
+        r"(?:第)?(?P<ordinal>\d+|[一二三四五六七八九十]+)(?:条|项|个)?"
+    )
+    raw_ordinals = [
+        str(item.group("ordinal") or "") for item in token_pattern.finditer(body)
+    ]
+    residual = token_pattern.sub("", body)
+    if (
+        len(raw_ordinals) < 2
+        or residual.strip(" \t、，,.。．与和及")
+    ):
+        return None
+    ordinals: list[int] = []
+    for raw in raw_ordinals:
+        ordinal = _chinese_ordinal(raw)
+        if ordinal is None or ordinal < 1:
+            return None
+        if ordinal not in ordinals:
+            ordinals.append(ordinal)
+    if len(ordinals) < 2:
+        return None
+
+    draft = resources.get("daily_draft")
+    draft = draft if isinstance(draft, dict) else {}
+    by_field = {
+        field: [
+            item
+            for item in (draft.get("items") or [])
+            if isinstance(item, dict) and str(item.get("field") or "") == field
+        ]
+        for field in ("today_work", "problems", "tomorrow_plan")
+    }
+    candidates = [
+        (field, items)
+        for field, items in by_field.items()
+        if all(ordinal <= len(items) for ordinal in ordinals)
+    ]
+    ordinal_label = "、".join(str(value) for value in ordinals)
+    if not candidates:
+        return _daily_clarification_payload(
+            source,
+            reason="daily_item_ordinals_out_of_range",
+            question=(
+                f"当前日报没有一个栏目同时包含第 {ordinal_label} 条。"
+                "本次没有修改，请说明栏目和条目编号。"
+            ),
+        )
+    if len(candidates) > 1:
+        count_label = "两个" if len(candidates) == 2 else "多个"
+        return _daily_clarification_payload(
+            source,
+            reason="daily_item_ordinals_section_ambiguous",
+            question=(
+                f"当前有{count_label}栏目都包含第 {ordinal_label} 条，"
+                "请说明要删今日工作、问题与风险还是明日计划；本次没有修改。"
+            ),
+        )
+
+    _, items = candidates[0]
+    targets = [items[ordinal - 1] for ordinal in ordinals]
+    target_ids = [str(item.get("item_id") or "").strip() for item in targets]
+    if any(not item_id for item_id in target_ids):
+        return _daily_clarification_payload(
+            source,
+            reason="daily_item_stable_id_missing",
+            question="目标内容还没有稳定条目编号；本次没有修改，请先查看当前日报。",
+        )
+
+    entity_ids = [f"daily-multi-index-delete-target-{index}" for index in range(1, len(target_ids) + 1)]
+    action_ids = [f"daily-multi-index-delete-action-{index}" for index in range(1, len(target_ids) + 1)]
+    return {
+        "intents": ["daily_modify"],
+        "segments": [
+            {
+                "segment_id": "daily-multi-index-delete-segment",
+                "text": source,
+                "intents": ["daily_modify"],
+                "entity_ids": entity_ids,
+                "action_ids": action_ids,
+                "start_offset": 0,
+                "end_offset": len(source),
+            }
+        ],
+        "entities": [
+            {
+                "entity_id": entity_id,
+                "entity_type": "daily_item_target",
+                "value": source,
+                "confidence": 1.0,
+                "attributes": {"target_item_ids": [item_id]},
+            }
+            for entity_id, item_id in zip(entity_ids, target_ids)
+        ],
+        "confidence": 1.0,
+        "required_actions": [
+            {
+                "action_id": action_id,
+                "action_type": "delete_daily_item",
+                "intent": "daily_modify",
+                "entity_ids": [entity_id],
+                "parameters": {},
+            }
+            for action_id, entity_id in zip(action_ids, entity_ids)
+        ],
+        "clarification_need": None,
+        "context_update": {
+            "current_goal": "daily_modify",
+            "remember_entity_ids": entity_ids,
+            "remember_turn": True,
+        },
+    }
+
+
+def _daily_clarification_payload(
+    text: str,
+    *,
+    reason: str,
+    question: str,
+) -> dict[str, Any]:
+    return {
+        "intents": ["daily_modify"],
+        "segments": [
+            {
+                "segment_id": "daily-deterministic-clarification",
+                "text": text,
+                "intents": ["daily_modify"],
+                "entity_ids": [],
+                "action_ids": [],
+            }
+        ],
+        "entities": [],
+        "confidence": 1.0,
+        "required_actions": [],
+        "clarification_need": {
+            "reason": reason,
+            "missing_fields": ["target_item_ids"],
+            "question": question,
+        },
+        "context_update": {
+            "current_goal": "daily_modify",
+            "remember_turn": True,
+        },
+    }
+
+
+def _chinese_ordinal(value: str) -> int | None:
+    if value.isdigit():
+        return int(value)
+    digits = {
+        "一": 1,
+        "二": 2,
+        "两": 2,
+        "三": 3,
+        "四": 4,
+        "五": 5,
+        "六": 6,
+        "七": 7,
+        "八": 8,
+        "九": 9,
+    }
+    if value in digits:
+        return digits[value]
+    if value == "十":
+        return 10
+    if value.startswith("十") and value[1:] in digits:
+        return 10 + digits[value[1:]]
+    if value.endswith("十") and value[:-1] in digits:
+        return digits[value[:-1]] * 10
+    return None
+
+
+def _parse_homogeneous_daily_lines(
+    source: str,
+) -> StructuredDailyDocument | None:
+    items: list[StructuredReportItem] = []
+    fields: set[str] = set()
+    cursor = 0
+    for raw_line in source.splitlines(keepends=True):
+        line = raw_line.rstrip("\r\n")
+        leading = len(line) - len(line.lstrip())
+        body = line[leading:]
+        if not body.strip():
+            cursor += len(raw_line)
+            continue
+        bullet = _BULLET_PREFIX.match(body)
+        if bullet is not None:
+            leading += bullet.end()
+            body = line[leading:].lstrip()
+            leading = line.find(body, leading)
+        else:
+            body = body.strip()
+            leading = line.find(body, leading)
+        prefix = _LINE_ITEM_PREFIX.match(body)
+        if prefix is None:
+            return None
+        if _DAILY_DEICTIC_ITEM_REFERENCE.search(body):
+            # This is a reference to existing items, not a new literal item.
+            # Leave it to the dedicated deictic projection contract, which
+            # verifies the requested count against the trusted draft.
+            return None
+        cue = prefix.group("prefix")
+        if cue.startswith(("今天", "今日", "当日")):
+            field = "today_work"
+        elif cue.startswith(("明天", "明日", "次日")):
+            field = "tomorrow_plan"
+        else:
+            field = "problems"
+        absolute_start = cursor + leading
+        items.append(
+            StructuredReportItem(
+                field=field,
+                value=body,
+                start_offset=absolute_start,
+                end_offset=absolute_start + len(body),
+            )
+        )
+        fields.add(field)
+        cursor += len(raw_line)
+    # This parser is called only when a trusted active Daily draft explicitly
+    # opted into homogeneous-line parsing.  One self-identifying temporal
+    # sentence is therefore sufficient and must be admitted before generic
+    # case-alias discovery can reinterpret its business nouns.
+    if not items:
+        return None
+    return StructuredDailyDocument(
+        items=tuple(items),
+        fields=frozenset(fields),
+    )
+
+
+def _parse_implicit_today_numbered_document(
+    source: str,
+) -> StructuredDailyDocument | None:
+    match = re.match(r"^\s*(?:今日工作|今天工作|当日工作)(?![：:])", source)
+    if match is None:
+        return None
+    if len(
+        re.findall(r"(?m)^\s*\d+[.、．)）]\s*\S", source[match.end() :])
+    ) < 2:
+        return None
+    items = _parse_section_items(
+        source,
+        field="today_work",
+        start_offset=match.end(),
+        end_offset=len(source),
+    )
+    if len(items) < 2:
+        return None
+    return StructuredDailyDocument(
+        items=items,
+        fields=frozenset({"today_work"}),
+    )
+
+
+def _parse_section_items(
+    source: str,
+    *,
+    field: str,
+    start_offset: int,
+    end_offset: int,
+) -> tuple[StructuredReportItem, ...]:
+    items: list[StructuredReportItem] = []
+    cursor = start_offset
+    for separator in _ITEM_SEPARATOR.finditer(source, start_offset, end_offset):
+        items.extend(_parse_item(source, field=field, start_offset=cursor, end_offset=separator.start()))
+        cursor = separator.end()
+    items.extend(_parse_item(source, field=field, start_offset=cursor, end_offset=end_offset))
+    return tuple(items)
+
+
+def _parse_item(
+    source: str,
+    *,
+    field: str,
+    start_offset: int,
+    end_offset: int,
+) -> tuple[StructuredReportItem, ...]:
+    raw = source[start_offset:end_offset]
+    leading = len(raw) - len(raw.lstrip())
+    trailing = len(raw.rstrip())
+    local_start = leading
+    local_end = trailing
+    repeated_header = re.match(
+        rf"(?P<label>{_LABEL_PATTERN})[：:]\s*",
+        raw[local_start:local_end],
+    )
+    if (
+        repeated_header is not None
+        and _DAILY_SECTION_LABELS[str(repeated_header.group("label") or "")] == field
+    ):
+        local_start += repeated_header.end()
+    inline_items = _parse_inline_numbered_items(
+        source,
+        field=field,
+        start_offset=start_offset + local_start,
+        end_offset=start_offset + local_end,
+    )
+    if inline_items:
+        return inline_items
+    numbered = _ITEM_NUMBER.match(raw[local_start:local_end])
+    if numbered is not None:
+        local_start += numbered.end()
+    value = raw[local_start:local_end].strip()
+    if not value:
+        return ()
+    if _GUIDANCE_LINE.match(value):
+        return ()
+    value_leading = len(raw[local_start:local_end]) - len(raw[local_start:local_end].lstrip())
+    absolute_start = start_offset + local_start + value_leading
+    absolute_end = absolute_start + len(value)
+    return (
+        StructuredReportItem(
+            field=field,
+            value=value,
+            start_offset=absolute_start,
+            end_offset=absolute_end,
+        ),
+    )
+
+
+def _parse_inline_numbered_items(
+    source: str,
+    *,
+    field: str,
+    start_offset: int,
+    end_offset: int,
+) -> tuple[StructuredReportItem, ...]:
+    fragment = source[start_offset:end_offset]
+    markers = list(_INLINE_NUMBERED_MARKER.finditer(fragment))
+    if len(markers) < 2 or fragment[: markers[0].start()].strip(" ，,；;。"):
+        return ()
+    items: list[StructuredReportItem] = []
+    for index, marker in enumerate(markers):
+        local_start = marker.end()
+        local_end = markers[index + 1].start() if index + 1 < len(markers) else len(fragment)
+        raw_value = fragment[local_start:local_end]
+        leading = len(raw_value) - len(raw_value.lstrip())
+        value = raw_value.strip(" \t\r\n，,；;。")
+        if not value:
+            return ()
+        absolute_start = start_offset + local_start + leading
+        while absolute_start < end_offset and source[absolute_start] in "，,；;。 ":
+            absolute_start += 1
+        items.append(
+            StructuredReportItem(
+                field=field,
+                value=value,
+                start_offset=absolute_start,
+                end_offset=absolute_start + len(value),
+            )
+        )
+    return tuple(items)
+
+
+def _parse_ordinal_plan_items(source: str) -> tuple[StructuredReportItem, ...]:
+    if re.match(r"^(?:哎[，,]?\s*)?(?:明日|明天)计划", source) is None:
+        return ()
+    markers = list(_ORDINAL_PLAN_MARKER.finditer(source))
+    if len(markers) < 2:
+        return ()
+    seen: list[int] = []
+    items: list[StructuredReportItem] = []
+    for index, marker in enumerate(markers):
+        ordinal = _chinese_ordinal(str(marker.group("ordinal") or ""))
+        if ordinal is None or ordinal in seen:
+            return ()
+        seen.append(ordinal)
+        start = marker.end()
+        end = markers[index + 1].start() if index + 1 < len(markers) else len(source)
+        raw_value = source[start:end]
+        leading = len(raw_value) - len(raw_value.lstrip())
+        value = raw_value.strip(" \t\r\n，,；;。")
+        if not value:
+            return ()
+        absolute_start = start + leading
+        items.append(
+            StructuredReportItem(
+                field="tomorrow_plan",
+                value=value,
+                start_offset=absolute_start,
+                end_offset=absolute_start + len(value),
+            )
+        )
+    return tuple(items)
+
+
+def _lossless_split_values(
+    value: str,
+    *,
+    desired_count: int,
+    field: str,
+) -> list[str]:
+    source = str(value or "").strip()
+    repeated_header = re.match(
+        rf"(?P<label>{_LABEL_PATTERN})[：:]\s*",
+        source,
     )
+    if (
+        repeated_header is not None
+        and _DAILY_SECTION_LABELS[str(repeated_header.group("label") or "")] == field
+    ):
+        source = source[repeated_header.end() :]
+    values = [part.strip() for part in re.split(r"[，,；;、]", source) if part.strip()]
+    if len(values) != desired_count:
+        return []
+    reconstructed = re.sub(r"[\s，,；;、]", "", source)
+    if "".join(re.sub(r"\s", "", item) for item in values) != reconstructed:
+        return []
+    return values
