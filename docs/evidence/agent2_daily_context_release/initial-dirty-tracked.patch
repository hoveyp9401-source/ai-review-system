+def daily_history_query_semantic_payload(
+    text: str,
+    resources: dict[str, Any],
+    *,
+    allow_current_backfill: bool = False,
+) -> dict[str, Any] | None:
+    """Resolve an explicit yesterday query from trusted history resources."""
+
+    source = str(text or "").strip()
+    if _DAILY_YESTERDAY_QUERY.fullmatch(source) is None:
+        return None
+    policy = resources.get("daily_policy")
+    policy = policy if isinstance(policy, dict) else {}
+    raw_current = str(policy.get("current_report_date") or "").strip()
+    try:
+        target_date = date.fromisoformat(raw_current) - timedelta(days=1)
+    except ValueError:
+        return _daily_clarification_payload(
+            source,
+            reason="daily_history_date_unavailable",
+            question="我暂时无法确定“昨天”对应的填报日期，本次没有改动任何内容。",
+        )
+    candidates = [
+        item
+        for item in (resources.get("daily_reports") or [])
+        if isinstance(item, dict)
+        and str(item.get("report_date") or "") == target_date.isoformat()
+        and str(item.get("report_id") or "").strip()
+    ]
+    if not candidates and allow_current_backfill:
+        draft = resources.get("daily_draft")
+        draft = draft if isinstance(draft, dict) else {}
+        report_id = str(draft.get("report_id") or "").strip()
+        if report_id:
+            entity_id = "daily-backfilled-history-query-target"
+            action_id = "daily-backfilled-history-query-action"
+            return {
+                "intents": ["daily_query"],
+                "segments": [
+                    {
+                        "segment_id": "daily-backfilled-history-query-segment",
+                        "text": source,
+                        "intents": ["daily_query"],
+                        "entity_ids": [entity_id],
+                        "action_ids": [action_id],
+                        "start_offset": 0,
+                        "end_offset": len(source),
+                    }
+                ],
+                "entities": [
+                    {
+                        "entity_id": entity_id,
+                        "entity_type": "daily_report",
+                        "value": source,
+                        "confidence": 1.0,
+                        "attributes": {
+                            "report_id": report_id,
+                            "version": draft.get("version"),
+                            "report_date": raw_current,
+                        },
+                    }
+                ],
+                "confidence": 1.0,
+                "required_actions": [
+                    {
+                        "action_id": action_id,
+                        "action_type": "query_daily_report",
+                        "intent": "daily_query",
+                        "entity_ids": [entity_id],
+                        "parameters": {},
+                    }
+                ],
+                "clarification_need": None,
+                "context_update": {
+                    "preserve_current_goal": True,
+                    "remember_entity_ids": [entity_id],
+                    "remember_turn": True,
+                },
+            }
+    if len(candidates) != 1:
+        return _daily_clarification_payload(
+            source,
+            reason=(
+                "daily_history_report_not_found"
+                if not candidates
+                else "daily_history_report_not_unique"
+            ),
+            question=(
+                f"没有找到 {target_date.isoformat()} 的唯一日报记录。"
+                f"当前填报日期是 {raw_current}；如需查看当前日报，请说“显示今天的日报”。"
+                "本次没有改动任何内容。"
+            ),
+        )
+    target = candidates[0]
+    entity_id = "daily-history-query-target"
+    action_id = "daily-history-query-action"
+    return {
+        "intents": ["daily_query"],
+        "segments": [
+            {
+                "segment_id": "daily-history-query-segment",
+                "text": source,
+                "intents": ["daily_query"],
+                "entity_ids": [entity_id],
+                "action_ids": [action_id],
+                "start_offset": 0,
+                "end_offset": len(source),
+            }
+        ],
+        "entities": [
+            {
+                "entity_id": entity_id,
+                "entity_type": "daily_report",
+                "value": source,
+                "confidence": 1.0,
+                "attributes": {
+                    "report_id": str(target["report_id"]),
+                    "version": target.get("version"),
+                    "report_date": target_date.isoformat(),
+                },
