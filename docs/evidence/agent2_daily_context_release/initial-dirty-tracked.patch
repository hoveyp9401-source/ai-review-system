+def daily_report_query_semantic_payload(
+    text: str,
+    resources: dict[str, Any],
+) -> dict[str, Any] | None:
+    """Bind a colloquial current-content question to a read-only Daily query.
+
+    Questions such as ``你都记录的是啥啊`` contain the word ``记录`` but no
+    destructive verb or confirmation.  This closed grammar keeps them away
+    from model-generated clear confirmations and binds the query only to the
+    trusted active Daily supplied by runtime resources.
+    """
+
+    source = str(text or "").strip()
+    if _DAILY_CURRENT_CONTENT_QUERY.fullmatch(source) is None:
+        return None
+    draft = resources.get("daily_draft")
+    draft = draft if isinstance(draft, dict) else {}
+    report_id = str(draft.get("report_id") or "").strip()
+    if not report_id:
+        return _daily_clarification_payload(
+            source,
+            reason="active_daily_report_not_unique",
+            question="当前没有可查看的日报。你可以直接说“开始写今天的日报”。",
+        )
+    entity_id = "daily-current-query-target"
+    action_id = "daily-current-query-action"
+    return {
+        "intents": ["daily_query"],
+        "segments": [
+            {
+                "segment_id": "daily-current-query-segment",
+                "text": source,
+                "intents": ["daily_query"],
