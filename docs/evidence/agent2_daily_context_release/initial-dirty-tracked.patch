+def daily_unscoped_ordinal_correction_semantic_payload(
+    text: str,
+    resources: dict[str, Any],
+) -> dict[str, Any] | None:
+    """Apply one closed ordinal correction when exactly one section owns it."""
+
+    source = str(text or "").strip().rstrip("！!")
+    match = _DAILY_UNSCOPED_ORDINAL_EDIT.fullmatch(source)
+    if match is None:
+        return None
+    ordinal = _chinese_ordinal(str(match.group("ordinal") or ""))
+    if ordinal is None or ordinal < 1:
+        return None
+    by_field = {
+        field: _trusted_daily_field_items(resources, field)
+        for field in ("today_work", "problems", "tomorrow_plan")
+    }
+    candidate_fields = [
+        field for field, items in by_field.items() if len(items) >= ordinal
+    ]
+    if len(candidate_fields) != 1:
+        return _daily_clarification_payload(
+            source,
+            reason="daily_ordinal_section_ambiguous",
+            question=(
+                "这个序号可能属于多个日报栏目。请补充“今日工作”“问题与风险”"
+                "或“明日计划”；本次没有修改。"
+            ),
+        )
+    target = by_field[candidate_fields[0]][ordinal - 1]
+    original = str(target.get("text") or "").strip()
+    body = str(match.group("body") or "").strip()
+    replacement = ""
+    suffix = re.fullmatch(
+        rf"第?{re.escape(str(match.group('ordinal') or ''))}(?:个|条|项|题)"
+        r"后面增加逗号[，,]?(?P<suffix>.+)",
+        body,
+    )
+    correction = re.fullmatch(
+        r"不是(?P<old>.+?)[，,]是(?P<new>.+)",
+        body,
+    )
+    spelling = re.match(r"(?P<new>跟盯)的盯是", body)
+    if suffix is not None:
+        value = str(suffix.group("suffix") or "").strip(" ，,")
+        if value:
+            replacement = original.rstrip("，,") + "，" + value
+    elif correction is not None:
+        old = str(correction.group("old") or "").strip()
+        new = str(correction.group("new") or "").strip()
+        if old and new and original.count(old) == 1:
+            replacement = original.replace(old, new, 1)
+        elif new and new in original:
+            return _daily_clarification_payload(
+                source,
+                reason="daily_correction_already_applied",
+                question=f"当前第 {ordinal} 条已经包含“{new}”，本次没有重复修改。",
+            )
+    elif spelling is not None:
+        if original.count("跟钉") == 1:
+            replacement = original.replace("跟钉", "跟盯", 1)
+        elif original.count("钉钉") == 1:
+            replacement = original.replace("钉钉", "跟盯", 1)
+        elif original.count("跟盯") == 1:
+            return _daily_clarification_payload(
+                source,
+                reason="daily_correction_already_applied",
+                question=f"当前第 {ordinal} 条已经使用“跟盯”，本次没有重复修改。",
+            )
+    elif not re.match(r"^(?:不是|第?\d|第?[一二三四五六七八九十])", body):
+        # ``逗号`` is an explicit voice-dictated punctuation token, not a
+        # business-fact rewrite.
+        replacement = body.replace("逗号", "，")
+    if not replacement:
+        return _daily_clarification_payload(
+            source,
+            reason="daily_ordinal_correction_not_deterministic",
+            question=(
+                f"我已定位到第 {ordinal} 条，但没能唯一确定修改后的完整内容。"
+                "本次没有修改；请直接发来这一条的新内容。"
+            ),
+        )
+    return _daily_item_edit_payload(
+        source,
+        target_id=str(target.get("item_id") or ""),
+        replacement=replacement,
+        field=candidate_fields[0],
+        segment_id="daily-unscoped-ordinal-edit-segment",
+        entity_id="daily-unscoped-ordinal-edit-target",
+        action_id="daily-unscoped-ordinal-edit-action",
+    )
+
+
+def _daily_item_edit_payload(
+    source: str,
+    *,
+    target_id: str,
+    replacement: str,
+    field: str = "",
+    segment_id: str,
+    entity_id: str,
+    action_id: str,
+) -> dict[str, Any]:
+    if not target_id:
+        return _daily_clarification_payload(
+            source,
+            reason="daily_item_stable_id_missing",
+            question="这条内容还没有稳定条目编号；本次没有修改，请先查看当前日报。",
