+    current_count = len(_trusted_daily_field_items(resources, "tomorrow_plan"))
+    if ordinal is None or ordinal != current_count + 1:
+        return None
+    value = str(match.group("value") or "").strip()
+    if not value:
+        return None
+    start = source.find(value, match.start("value"))
+    entity_id = "daily-ordinal-append-event"
+    action_id = "daily-ordinal-append-action"
+    return {
