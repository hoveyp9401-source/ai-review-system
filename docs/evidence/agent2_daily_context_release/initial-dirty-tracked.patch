+def _daily_fact_equivalence_key(value: str, field: str) -> str:
+    """Canonical comparison key; the stored user fact remains untouched."""
+
+    source = str(value or "").strip()
+    prefixes = {
+        "today_work": r"^(?:(?:今天|今日|当日)(?:工作完成情况|完成情况|工作|完成)?)",
+        "problems": r"^(?:碰到|遇到)?(?:问题[与和/]?风险|风险[与和/]?问题|问题|风险)",
+        "tomorrow_plan": r"^(?:(?:明天|明日|次日)(?:工作计划|计划|工作|安排)?)",
+    }
+    prefix = prefixes.get(str(field or ""))
+    if prefix:
+        source = re.sub(prefix, "", source, count=1).lstrip("：:，,。 ")
+    return re.sub(r"[\s，,。．:：；;]", "", source).casefold()
+
+
+def _daily_fact_is_already_present(
+    incoming_key: str,
+    *,
+    existing_keys: Collection[str],
+) -> bool:
+    if incoming_key in existing_keys:
+        return True
+    # A user may restate one already-recorded clause from a longer item.  The
+    # one-way containment rule suppresses that duplicate, but never treats a
+    # longer incoming fact as equivalent to a shorter stored fact (which would
+    # silently discard newly supplied detail).
+    return len(incoming_key) >= 8 and any(
+        incoming_key in existing_key for existing_key in existing_keys
     )
 
 
