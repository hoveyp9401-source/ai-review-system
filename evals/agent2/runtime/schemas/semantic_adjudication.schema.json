{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent2.semantic_adjudication.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "turn_id", "reviewer_id", "reviewed_at", "decision", "adjudicated_label", "disagreements"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["approve", "correct", "reject", "needs_second_review"]},
    "adjudicated_label": {"type": ["object", "null"]},
    "disagreements": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"},
    "reviewer_signature": {"type": "string"}
  }
}
