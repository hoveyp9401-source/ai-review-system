{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent2.runtime_sealed_labels.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_pack_id", "input_pack_digest", "labels", "seal_hash"],
  "properties": {
    "schema_version": {"const": "agent2.runtime_sealed_labels.v1"},
    "input_pack_id": {"type": "string", "minLength": 1},
    "input_pack_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "turn_id", "independent_review_status"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "turn_id": {"type": "string", "minLength": 1},
          "expected_current_goal": {"type": ["string", "null"]},
          "expected_entities": {"type": "array"},
          "expected_segment_boundaries": {"type": "array"},
          "expected_domain_ownership": {"type": "array", "items": {"type": "string"}},
          "expected_action_class": {"type": "array", "items": {"type": "string"}},
          "expected_executable": {"type": "boolean"},
          "expected_clarification_requirement": {"type": "boolean"},
          "expected_write_intent": {"type": "boolean"},
          "expected_command_type": {"type": "array", "items": {"type": "string"}},
          "expected_no_write_reason": {"type": ["string", "null"]},
          "risk_annotation": {"type": "string"},
          "provenance": {"type": "object"},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "independent_review_status": {"enum": ["pending", "human_approved", "human_corrected", "rejected"]},
          "adjudication": {"type": ["object", "null"]}
        }
      }
    }
  }
}
