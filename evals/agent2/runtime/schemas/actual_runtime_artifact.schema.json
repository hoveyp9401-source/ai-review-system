{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent2.runtime_actual_artifact.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "input_pack_id", "input_pack_digest", "runtime_version_hash", "completed", "cases", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "agent2.runtime_actual_artifact.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "input_pack_id": {"type": "string", "minLength": 1},
    "input_pack_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_version_hash": {"type": "string", "minLength": 1},
    "completed": {"const": true},
    "cases": {"type": "array"},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
