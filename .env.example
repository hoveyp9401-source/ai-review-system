LEGAL_OPS_SANDBOX_DEFAULT_TENANT=
LEGAL_OPS_SANDBOX_TOKEN=
LEGAL_OPS_SANDBOX_PRINCIPALS_JSON=
LEGAL_OPS_LIVE_ENABLED=false
LEGAL_OPS_LIVE_TENANT_ID=
LEGAL_OPS_LIVE_TOKEN=
LEGAL_OPS_LIVE_PRINCIPALS_JSON=
LEGAL_OPS_DATA_INTAKE_ENABLED=false
LEGAL_OPS_DATA_INTAKE_STORAGE_PATH=data/legal_ops_data_intake
LEGAL_OPS_DATA_INTAKE_MAX_FILE_MB=25
LEGAL_OPS_DATA_INTAKE_MAX_ROWS=100000
LEGAL_OPS_RULE_UNDERSTANDING_ENABLED=false
LEGAL_OPS_RULE_UNDERSTANDING_MODEL=replace-me
LEGAL_OPS_RULE_UNDERSTANDING_TIMEOUT_SECONDS=90
LEGAL_OPS_RULE_UNDERSTANDING_LONG_DOCUMENT_TIMEOUT_SECONDS=180

# 绩效与日报看板
AGENT2_PERFORMANCE_KNOWLEDGE_ENABLED=false
AGENT2_PERFORMANCE_TOOL_ENABLED=false
AGENT2_PERFORMANCE_KNOWLEDGE_TIMEOUT_SECONDS=8
LEGAL_DAILY_DASHBOARD_ENABLED=false
AGENT2_CROSS_USER_DAILY_READ_ENABLED=false
LEGAL_DAILY_DASHBOARD_TENANT_ID=
LEGAL_DAILY_DASHBOARD_TOKEN=
LEGAL_DAILY_DASHBOARD_PRINCIPALS_JSON=
