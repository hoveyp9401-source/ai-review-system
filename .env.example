# Legal Operations Phase 0 is disabled unless explicitly enabled.
LEGAL_OPS_SANDBOX_ENABLED=false
LEGAL_OPS_SANDBOX_DATA_PATH=data/legal_ops_sandbox.json
LEGAL_OPS_SANDBOX_SEED_MANIFEST=app/legal_ops/fixtures/phase0_manifest.json
LEGAL_OPS_SANDBOX_DEFAULT_TENANT=
LEGAL_OPS_SANDBOX_TOKEN=
# Optional server-side token-to-principal map. Never expose it to frontend code.
LEGAL_OPS_SANDBOX_PRINCIPALS_JSON=
# Mutually exclusive with Demo mode. Live mode reads only the allowed Agent2
# Sandbox tenant from PostgreSQL and never falls back to Seed data.
LEGAL_OPS_LIVE_ENABLED=false
LEGAL_OPS_LIVE_TENANT_ID=
LEGAL_OPS_LIVE_TOKEN=
LEGAL_OPS_LIVE_PRINCIPALS_JSON=

# Agent2 Phase 2 remains fail-closed until both the feature and an explicit
# Sandbox/test-tenant allowlist are configured. Never list a formal tenant here.
AGENT2_BUSINESS_PHASE2_ENABLED=false
AGENT2_BUSINESS_TENANT_IDS=
AGENT2_BUSINESS_PARTY_QUERY_ENABLED=false
AGENT2_BUSINESS_CASE_PROGRESS_ENABLED=false
AGENT2_BUSINESS_CASE_PROGRESS_WRITE_ENABLED=false
AGENT2_BUSINESS_TRAVEL_ENABLED=false
AGENT2_BUSINESS_TRAVEL_WRITE_ENABLED=false

# Semantic Admission is off by default.  Shadow requires both a Sandbox tenant
# and explicit user allowlists.  ENFORCE must remain false until the Safety,
# Usability, PostgreSQL, and operational gates have all been evidenced.
AGENT2_SEMANTIC_ADMISSION_ENABLED=false
AGENT2_SEMANTIC_ADMISSION_ENFORCE=false
AGENT2_SEMANTIC_ADMISSION_REVIEW_CAPTURE=false
AGENT2_SEMANTIC_ADMISSION_DEFERRED_CAPTURE=false
AGENT2_SEMANTIC_ADMISSION_SHADOW_REPLAY=false
AGENT2_SEMANTIC_ADMISSION_TENANT_ALLOWLIST=
AGENT2_SEMANTIC_ADMISSION_USER_ALLOWLIST=

AGENT2_TRAVEL_NOTIFICATION_WORKER_ENABLED=false
AGENT2_TRAVEL_NOTIFICATION_WORKER_INTERVAL_SECONDS=15
AGENT2_TRAVEL_NOTIFICATION_BATCH_SIZE=50
AGENT2_TRAVEL_NOTIFICATION_MAX_ATTEMPTS=5
AGENT2_TRAVEL_NOTIFICATION_RETRY_BASE_SECONDS=30
AGENT2_TRAVEL_NOTIFICATION_STALE_LOCK_MINUTES=10
CASE_FOLLOWUP_CONVERSATION_MAP_JSON={}
CASE_FOLLOWUP_ENABLED=false
CASE_FOLLOWUP_SEND_ENABLED=false
CASE_FOLLOWUP_REPORT_PROJECTION_ENABLED=false
CASE_FOLLOWUP_USER_ALLOWLIST=
CASE_FOLLOWUP_TENANT_ALLOWLIST=
CASE_FOLLOWUP_TRIGGER_ALLOWLIST=
CASE_FOLLOWUP_DAILY_LIMIT=3
CASE_FOLLOWUP_CASE_DAILY_LIMIT=1
