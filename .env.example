AGENT2_SEMANTIC_ADMISSION_ENFORCE=false
AGENT2_SEMANTIC_ADMISSION_REVIEW_CAPTURE=false
AGENT2_SEMANTIC_ADMISSION_DEFERRED_CAPTURE=false
