# 本文件只包含安全模板。复制为 .env 后再填写本地或受控环境值。

# 基础设置
APP_NAME=ai-review-system
APP_ENV=development
TIMEZONE=Asia/Shanghai
CLOCK_OVERRIDE_ENABLED=false
CLOCK_OVERRIDE_NOW=

# Docker Compose 本地数据库
POSTGRES_DB=review
POSTGRES_USER=review
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000

# 非 Compose 部署时填写完整连接串。不要提交真实口令。
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# LLM
LLM_BASE_URL=https://api.example.invalid/v1
LLM_API_KEY=
LLM_MODEL=replace-me
LLM_INTENT_MODEL=replace-me
LLM_EXTRACT_MODEL=replace-me
LLM_SUMMARY_MODEL=replace-me
LLM_HIGH_RISK_MODEL=replace-me
LLM_DRAFT_DECISION_ENABLED=false
REPORT_AGENT_ENABLED=false
REPORT_AGENT_SHADOW_MODE=false

# 管理接口默认关闭
ADMIN_ENABLED=false
ADMIN_TOKEN=

# 钉钉。只有测试 Stream 或 Webhook 时才填写。
DINGTALK_INCOMING_TOKEN=
DINGTALK_CALLBACK_TOKEN=
DINGTALK_CALLBACK_AES_KEY=
DINGTALK_DEFAULT_ROBOT_WEBHOOK=
DINGTALK_DEFAULT_ROBOT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_API_BASE_URL=https://api.dingtalk.com
DINGTALK_OAPI_BASE_URL=https://oapi.dingtalk.com

# Scheduler 默认只演练、不发送
SCHEDULER_ENABLED=false
REMINDER_SEND_ENABLED=false
REMINDER_DRY_RUN=true
REMINDER_TEST_USER_IDS=
AUTO_SUBMIT_CRON_HOUR=8
SCHEDULER_PAUSE_DATES=

# Agent2 日报受控开关
WORKFLOW_INTAKE_MODE=observe_only
AGENT2_DAILY_ENABLED=false
AGENT2_DAILY_ENABLED_USER_IDS=
AGENT2_COGNITIVE_CORE_V3_ENABLED=false
AGENT2_FACT_ALL_ACCESS_DINGTALK_USER_IDS=
AGENT2_FACT_ALL_ACCESS_NAMES=

# 法务工作台和数据接入
LEGAL_OPS_SANDBOX_ENABLED=false
LEGAL_OPS_SANDBOX_DATA_PATH=data/legal_ops_sandbox.json
